+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+*/
+
+/* Include files */
+#include "ss_fscryptctl.h"
+
+static RDK_SS_FUNCTION_STRUCT gsRdkSsFunction;
+static unsigned char gsbRdkSSInitialization;
+
+/* Human-readable strings for encryption modes, indexed by the encryption mode */
+static const char *const mode_strings[] = {
+    [FSCRYPT_MODE_AES_256_XTS] = "AES-256-XTS",
+    [FSCRYPT_MODE_AES_256_CTS] = "AES-256-CTS",
+    [FSCRYPT_MODE_AES_128_CBC] = "AES-128-CBC",
+    [FSCRYPT_MODE_AES_128_CTS] = "AES-128-CTS",
+    [FSCRYPT_MODE_SM4_XTS] = "SM4-XTS",
+    [FSCRYPT_MODE_SM4_CTS] = "SM4-CTS",
+    [FSCRYPT_MODE_ADIANTUM] = "Adiantum",
+    [FSCRYPT_MODE_AES_256_HCTR2] = "AES-256-HCTR2",
+};
+
+/* Valid amounts of filename padding, indexed by the padding flag */
+static const int padding_values[] = {4, 8, 16, 32};
+
+/* Session handling structure */
+struct session_t *head_session = NULL;
+
+/* extern variables and functions */
+extern char identifier_hex[33];
+extern int cmd_get_policy(int argc, char *const argv[]);
+extern int cmd_remove_key(int argc, char *const argv[]);
+
+/* Function protypes */
+static void string_to_mode(const char *str, unsigned char *mode_ret);
+static int string_to_padding_flag(const char *str);
+static int get_fileDesc(unsigned int sessionId);
+static int is_session_exist(char *applicationPath,unsigned int *sessionId);
+static int insert_session_info (int fd, char *rootDir, unsigned int sessionId);
+static int free_session_info(unsigned int sessionId);
+static void remove_last_slash_char(char *str);
+static char *get_application_path(unsigned int sessionId);
+static int fscrypt_removeKey(char *keyid , char *mountpoint);
+static unsigned int fscrypt_getPolicy(char *dirPath);
+static unsigned int convertErrnoToSSErrorCode( int errNo, unsigned int sessionId);
+static int create_dir(char *dirPath);
+static int check_and_create_dir(char *dir);
+static unsigned int check_ownership_capability(char *path);
+static int get_fscrypt_encryption_mode(unsigned char *contents_encryption_mode,
+unsigned char *filenames_encryption_mode, unsigned char *padding_flags);
+
+/* Function Definition */
+
+/***************************************************************************
+ * @brief API used to Converts str to an encryption mode.
+ * @param str indicates encryption mode as a string.
+ * @param mode_ret to get encryption mode value.
+ * @return None.
+ ***************************************************************************/
+static void string_to_mode(const char *str, unsigned char *mode_ret)
+{
+    if(str == NULL || mode_ret == NULL)
+        return;
+
+    for (size_t i = 0; i < ARRAY_SIZE(mode_strings); i++)
+    {
+        if (mode_strings[i] != NULL && strcmp(str, mode_strings[i]) == 0)
+        {
+            *mode_ret = i;
+            return;
+        }
+    }
+    return;
+}
+
+/***************************************************************************
+ * @brief API used to converts an amount of padding (as a string) into the appropriate padding flag.
+ * @param str indicates padding as a string.
+ * @return appropriate padding flag value upon success else returns -1 if the flag is invalid.
+ ***************************************************************************/
+static int string_to_padding_flag(const char *str)
+{
+    if(str == NULL)
+        return -1;
+
+    int padding = atoi(str);
+    for (size_t i = 0; i < ARRAY_SIZE(padding_values); i++)
+    {
+        if (padding == padding_values[i])
+        {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/***************************************************************************
+ * @brief API used to get the file decriptor from session info structure.
+ * @param sessionId used to represent the session.
+ * @return file descriptor value upon success else returns -1 if the sessionId is invalid.
+ ***************************************************************************/
+static int get_fileDesc(unsigned int sessionId)
+{
+    struct session_t *ptr = head_session;
+
+    while(ptr != NULL)
+    {
+        if(ptr->session_id == sessionId)
+        {
+            return ptr->fd;
+        }
+        ptr = ptr->next;
+    }
+
+    return -1;
+}
+
+/***************************************************************************
+ * @brief API used to check the session is exist or not based on the application secure directory path.
+ * @param applicationPath indicates application secure directory path.
+ * @return 0 upon success else returns -1.
+ ***************************************************************************/
+static int is_session_exist(char *applicationPath,unsigned int *sessionId)
+{
+    struct session_t *ptr = head_session;
+
+    if(sessionId == NULL || applicationPath == NULL)
+        return -1;
+
+    while(ptr != NULL)
+    {
+        if (strncmp(ptr->rootDir,applicationPath,strlen(ptr->rootDir))==0)
+        {
+            *sessionId = ptr->session_id;
+            return 0;
+        }
+        ptr = ptr->next;
+    }
+
+    return -1;
+}
+
+/***************************************************************************
+ * @brief API used to add the session info into the session list.
+ * @param fd indicates File descriptor.
+ * @param rootDir indicates application secure directory path.
+ * @param sessionId indicates the session info.
+ * @return 0 upon success else returns -1.
+ ***************************************************************************/
+static int insert_session_info (int fd, char *rootDir, unsigned int sessionId)
+{
+    int len = 0;
+
+    if(rootDir == NULL)
+            return -1;
+
+    struct session_t *link = (struct session_t*) malloc(sizeof(struct session_t));
+    if (link == NULL)
+    {
+        printf("%s:%d Mem Alloc Fail\n",__FILE__,__LINE__);
+        return -1;
+    }
+    link->rootDir = (char *) malloc(strlen(rootDir)+1);
+    if (link->rootDir == NULL)
+    {
+        printf("%s:%d Mem Alloc Fail\n",__FILE__,__LINE__);
+        free(link);
+        return -1;
+    }
+    link->fd = fd;
+    len = strlen(rootDir);
+    strncpy(link->rootDir,rootDir,len);
+    link->rootDir[len++]='\0';
+    link->session_id = sessionId;
+    link->next = head_session;
+    head_session = link;
+
+    return 0;
+}
+
+/***************************************************************************
+ * @brief API used to delete/free the session info from the session list.
+ * @param sessionId is used to represent the session.
+ * @return 0 upon success else returns -1.
+ ***************************************************************************/
+static int free_session_info(unsigned int sessionId)
+{
+    struct session_t *current = head_session, *previous;
+
+    if (head_session == NULL)
+    {
+        printf("%s:%d Error : Invalid  Session!!!\n",__FILE__,__LINE__);
+        return -1;
+    }
+
+    if (current->session_id == sessionId)
+    {
+        head_session = current->next;
+        close(current->fd);
+        free(current->rootDir);
+        free(current);
+        return 0;
+    }
+
+    while (current != NULL && current->session_id != sessionId)
+    {
+        previous = current;
+        current = current->next;
+    }
+
+    if (current == NULL)
+    {
+        printf("%s:%d Session info not found \n",__FILE__,__LINE__);
+        return -1;
+    }
+    previous->next = current->next;
+    close(current->fd);
+    free(current->rootDir);
+    free(current);
+
+    return 0;
+}
+
+/***************************************************************************
+ * @brief API used to remove the last character '/' from application secure directory path.
+ * @param str indicates application secure directory path.
+ * @return None.
+ ***************************************************************************/
+static void remove_last_slash_char(char *str)
+{
+    char *temp = NULL;
+
+    if(str == NULL)
+    {
+        return;
+    }
+
+    temp = strrchr(str,'/');
+
+    if(temp == NULL)
+    {
+        return;
+    }
+
+    if (strlen(temp) == 1 && strlen(str) > 1)
+    {
+        str[strlen(str) -1] = '\0';
+    }
+}
+
+/***************************************************************************
+ * @brief API used to get the application secure directory path based on session id.
+ * @param sessionId indicates session info.
+ * @return application secure directory path upon success else returns a NULL.
+ ***************************************************************************/
+static char *get_application_path(unsigned int sessionId)
+{
+    struct session_t *ptr = head_session;
+
+    while(ptr != NULL)
+    {
+        if(ptr->session_id == sessionId)
+        {
+            return ptr->rootDir;
+        }
+        ptr = ptr->next;
+    }
+
+    return NULL;
+}
+
+/***************************************************************************
+ * @brief API used to encrypt the application secure directory.
+ * @param keyid indicates key identifier.
+ * @param mountpoint indicates application secure directory mountpoint.
+ * @return EXIT_SUCCESS upon success else returns a EXIT_FAILURE.
+ ***************************************************************************/
+static int fscrypt_removeKey(char *keyid , char *mountpoint)
+{
+    char *const argv1[]={"remove_key",keyid,mountpoint};
+    return cmd_remove_key(3,argv1);
+}
+
+/***************************************************************************
+ * @brief API used to get the key identifier value.
+ * @param dirPath indicates application secure directory path.
+ * @return RDK_SS_ERROR_SUCCESS upon success else returns a RDK_SS_ERROR_FAILURE.
+ ***************************************************************************/
+static unsigned int fscrypt_getPolicy(char *dirPath)
+{
+    char *mountpoint = NULL;
+    char *temp_path = NULL;
+    int len =0;
+    char *const argv1[]={"get_policy",dirPath};
+    int ret = EXIT_FAILURE;
+
+    if(dirPath == NULL)
+          return RDK_SS_ERROR_FAILURE;
+
+    ret = cmd_get_policy(2,argv1);
+
+    if (ret == EXIT_SUCCESS)
+    {
+        mountpoint = (char *)malloc(strlen(dirPath));
+        if (mountpoint == NULL)
+        {
+            printf("%s:%d Mem Alloc Fail\n",__FILE__,__LINE__);
+            return RDK_SS_ERROR_FAILURE;
+        }
+
+        temp_path = strrchr(dirPath,'/');
+        len = strlen(dirPath)-strlen(temp_path);
+        strncpy(mountpoint, dirPath,len);
+        mountpoint [len++] = '\0';
+        ret = fscrypt_removeKey(identifier_hex,mountpoint);
+        free(mountpoint);
+    }
+
+    if (ret == EXIT_FAILURE)
+    {
+        return RDK_SS_ERROR_FAILURE;
+    }
+
+    return RDK_SS_ERROR_SUCCESS;
+}
+
+/***************************************************************************
+ * @brief API used to get the return value based on the error number.
+ * @param errNo indicates error number from the kernel.
+ * @param sessionId indicates session info.
+ * @return appropriate error value.
+ ***************************************************************************/
+static unsigned int convertErrnoToSSErrorCode( int errNo, unsigned int sessionId)
+{
+    unsigned int status = RDK_SS_ERROR_FAILURE;
+    char *dirPath = NULL;
+    int ret = -1;
+
+    if (errNo == ENOENT || errNo == EIO || errNo == EFAULT || errNo == EINVAL || errNo == ENODATA )
+    {
+        status = RDK_SS_ERROR_INVALID_INPUT;
+    }
+    else if( errNo == ENOMEM)
+    {
+        status = RDK_SS_ERROR_NOT_ENOUGH_MEMORY;
+    }
+    else if (errNo == EFBIG)
+    {
+        status = RDK_SS_ERROR_NOT_ENOUGH_MEMORY;
+    }
+    else if (errNo == EBUSY)
+    {
+        dirPath = get_application_path(sessionId);
+        if (dirPath != NULL)
+        {
+            status = fscrypt_getPolicy(dirPath);
+        }
+    }
+    else if (errNo == ENOKEY)
+    {
+        ret = free_session_info(sessionId);
+        if (ret < 0)
+        {
+            printf("%s:%d Free session info fail\n",__FILE__,__LINE__);
+            return RDK_SS_ERROR_FAILURE;
+        }
+        status = RDK_SS_ERROR_SUCCESS;
+    }
+    return status;
+}
+
+/***************************************************************************
+ * @brief API used to create a sub folder if not exist.
+ * @param dirPath indicates sub folder path.
+ * @return 0 upon success else returns appropriate error value.
+ ***************************************************************************/
+static int create_dir(char *dirPath)
+{
+    char *p = NULL;
+    char *dPath = strdup(dirPath);
+    int status = -1;
+
+    if(dirPath == NULL)
+        return status;
+
+    for (p = dPath + 1; *p; p++)
+    {
+        if (*p == '/')
+        {
+            *p = '\0';
+            if (access(dPath, F_OK) == -1)
+            {
+                status = mkdir(dPath, 0700);
+                if((status < 0) && (status != -EEXIST))
+                {
+                    return status;
+                }
+            }
+            *p = '/';
+        }
+    }
+    status = mkdir(dPath, 0700);
+    return status;
+}
+
+/***************************************************************************
+ * @brief API used to create the specified directory in restrictive mode.
+ * @param dir indicates directory path.
+ * @return 0 upon success else returns appropriate error value.
+ ***************************************************************************/
+static int check_and_create_dir(char *dir)
+{
+    int status = -1;
+
+    if (dir == NULL)
+    {
+        printf("%s:%d the dir is NULL\n", __FILE__,__LINE__);
+        return status;
+    }
+    if (access(dir, F_OK) == 0)
+    {
+        return 0;
+    }
+    status = mkdir(dir, DIR_MODE);
+    if (status < 0)
+    {
+        status = create_dir(dir);
+    return status;
+    }
+    return status;
+}
+
+/***************************************************************************
+ * @brief API used to check the ownership capability.
+ * @param path indicates application secure directory path.
+ * @return RDK_SS_ERROR_SUCCESS upon success else returns RDK_SS_ERROR_FAILURE.
+ ***************************************************************************/
+static unsigned int check_ownership_capability(char *path)
+{
+    struct stat sb;
+    uid_t process_euid;
+    if(path == NULL)
+        return RDK_SS_ERROR_FAILURE;
+
+    if(stat(path, &sb) == -1)
+    {
+        return RDK_SS_ERROR_FAILURE;
+    }
+    process_euid = geteuid();
+    if(process_euid != sb.st_uid)
+    {
+        printf("%s:%d Encryption directory accces is restricted to user\n",__FILE__,__LINE__);
+        return RDK_SS_ERROR_FAILURE;
+    }
+    return RDK_SS_ERROR_SUCCESS;
+}
+
+/***************************************************************************
+ * @brief API used to get the content,filename encryption mode value and padding flag.
+ * @param contents_encryption_mode indicates contents encryption mode as a string.
+ * @param filenames_encryption_mode indicates filenames encryption mode as a string.
+ * @param padding_flags indicates padding flags as a string.
+ * @return 0 upon success else returns appropriate error value.
+ ***************************************************************************/
+static int get_fscrypt_encryption_mode(unsigned char *contents_encryption_mode,
+                unsigned char *filenames_encryption_mode, unsigned char *padding_flags )
+{
+    FILE *fp = NULL;
+    char line[256] = {0};
+
+    if(contents_encryption_mode == NULL || filenames_encryption_mode == NULL || padding_flags == NULL)
+        return -1;
+
+    fp = fopen("/etc/fscrypt.conf","r");
+
+    if (fp == NULL)
+    {
+        printf("%s:%d Unable to read fscrypt.conf file \n",__FILE__,__LINE__);
+        return -1;
+    }
+
+    while( fgets(line, sizeof(line), fp))
+    {
+        line[strcspn(line, "\n")] = '\0';
+        if(strncmp(FSCRYPT_PADDING,line,strlen(FSCRYPT_PADDING)) == 0)
+        {
+            char *s = strchr(line,':');
+            s++;
+            *padding_flags = string_to_padding_flag(s);
+        }
+        else if(strncmp(FSCRYPT_CONTENTS,line,strlen(FSCRYPT_CONTENTS)) == 0)
+        {
+            char *s = strchr(line,':');
+            s++;
+            string_to_mode(s, contents_encryption_mode);
+        }
+        else if (strncmp(FSCRYPT_FILENAMES,line,strlen(FSCRYPT_FILENAMES)) == 0)
+        {
+            char *s = strchr(line,':');
+            s++;
+            string_to_mode(s, filenames_encryption_mode);
+        }
+    }
+    fclose(fp);
+
+    return 0;
+}
