+/* Human-readable strings for encryption modes, indexed by the encryption mode */
+static const char *const mode_strings[] = {
+	[FSCRYPT_MODE_AES_256_XTS] = "AES-256-XTS",
+	[FSCRYPT_MODE_AES_256_CTS] = "AES-256-CTS",
+	[FSCRYPT_MODE_AES_128_CBC] = "AES-128-CBC",
+	[FSCRYPT_MODE_AES_128_CTS] = "AES-128-CTS",
+	[FSCRYPT_MODE_SM4_XTS] = "SM4-XTS",
+	[FSCRYPT_MODE_SM4_CTS] = "SM4-CTS",
+	[FSCRYPT_MODE_ADIANTUM] = "Adiantum",
+	[FSCRYPT_MODE_AES_256_HCTR2] = "AES-256-HCTR2",
+};
+
+/* Valid amounts of filename padding, indexed by the padding flag */
+static const int padding_values[] = {4, 8, 16, 32};
+
+/* Session handling structure */
+struct session_t *head_session = NULL;
+
+/* extern variables and functions */
+extern char identifier_hex[33];
+extern int cmd_get_policy(int argc, char *const argv[]);
+extern int cmd_remove_key(int argc, char *const argv[]);
+
+/* Function protypes */
+static void string_to_mode(const char *str, unsigned char *mode_ret);
+static int string_to_padding_flag(const char *str);
+static int get_ioctl_fd(unsigned int sessionId);
+static int is_session_exist(char *applicationPath,unsigned int *sessionId);
+static int insert_session_info (int fd, char *rootDir, unsigned int sessionId);
+static int free_session_info(unsigned int sessionId);
+static void remove_last_slash_char(char *str);
+static char *get_application_path(unsigned int sessionId);
+static int fscrypt_removeKey(char *keyid , char *mountpoint);
+static unsigned int fscrypt_getPolicy(char *dirPath);
+static unsigned int get_errno_return_value( int errNo, unsigned int sessionId);
+static int create_dir(char *dirPath);
+static int check_and_create_dir(char *dir);
+static unsigned int check_ownership_capability(char *path);
+static int get_fscrypt_encryption_mode(unsigned char *contents_encryption_mode,
+				unsigned char *filenames_encryption_mode, unsigned char *padding_flags);
+
+/* Function Definition */
+
+/***************************************************************************
+ * @brief API used to Converts str to an encryption mode.
+ * @param str indicates encryption mode as a string.
+ * @param mode_ret to get encryption mode value.
+ * @return None.
+ ***************************************************************************/
+static void string_to_mode(const char *str, unsigned char *mode_ret)
+{
+	if(str == NULL || mode_ret == NULL)
+		return;
+
+	for (size_t i = 0; i < ARRAY_SIZE(mode_strings); i++)
+	{
+		if (mode_strings[i] != NULL && strcmp(str, mode_strings[i]) == 0)
+		{
+			*mode_ret = i;
+			return;
+		}
+	}
+	return;
+}
+
+/***************************************************************************
+ * @brief API used to converts an amount of padding (as a string) into the appropriate padding flag.
+ * @param str indicates padding as a string.
+ * @return appropriate padding flag value upon success else returns -1 if the flag is invalid.
+ ***************************************************************************/
+static int string_to_padding_flag(const char *str)
+{
+	if(str == NULL)
+		return -1;
+
+	int padding = atoi(str);
+	for (size_t i = 0; i < ARRAY_SIZE(padding_values); i++)
+	{
+		if (padding == padding_values[i])
+		{
+			return i;
+		}
+	}
+	return -1;
+}
+
+/***************************************************************************
+ * @brief API used to get the file decriptor from session info structure.
+ * @param sessionId used to represent the session.
+ * @return file descriptor value upon success else returns -1 if the sessionId is invalid.
+ ***************************************************************************/
+static int get_ioctl_fd(unsigned int sessionId)
+{
+	struct session_t *ptr = head_session;
+
+	while(ptr != NULL)
+	{
+		if(ptr->session_id == sessionId)
+		{
+			return ptr->fd;
+		}
+		ptr = ptr->next;
+	}
+
+	return -1;
+}
+
+/***************************************************************************
+ * @brief API used to check the session is exist or not based on the application secure directory path.
+ * @param applicationPath indicates application secure directory path.
+ * @return 0 upon success else returns -1.
+ ***************************************************************************/
+static int is_session_exist(char *applicationPath,unsigned int *sessionId)
+{
+	struct session_t *ptr = head_session;
+
+	if(sessionId == NULL || applicationPath == NULL)
+		return -1;
+
+	while(ptr != NULL)
+	{
+		if (strncmp(ptr->rootDir,applicationPath,strlen(ptr->rootDir))==0)
+		{
+			*sessionId = ptr->session_id;
+			return 0;
+		}
+		ptr = ptr->next;
+	}
+
+	return -1;
+}
+
+/***************************************************************************
+ * @brief API used to add the session info into the session list.
+ * @param fd indicates File descriptor.
+ * @param rootDir indicates application secure directory path.
+ * @param sessionId indicates the session info.
+ * @return 0 upon success else returns -1.
+ ***************************************************************************/
+static int insert_session_info (int fd, char *rootDir, unsigned int sessionId)
+{
+	int len = 0;
+
+	if(rootDir == NULL)
+        	return -1;
+
+	struct session_t *link = (struct session_t*) malloc(sizeof(struct session_t));
+	if (link == NULL)
+	{
+		printf("%s:%d Mem Alloc Fail\n",__FILE__,__LINE__);
+		return -1;
+	}
+	link->rootDir = (char *) malloc(strlen(rootDir)+1);
+	if (link->rootDir == NULL)
+	{
+		printf("%s:%d Mem Alloc Fail\n",__FILE__,__LINE__);
+		free(link);
+		return -1;
+	}
+	link->fd = fd;
+	len = strlen(rootDir);
+	strncpy(link->rootDir,rootDir,len);
+	link->rootDir[len++]='\0';
+	link->session_id = sessionId;
+	link->next = head_session;
+	head_session = link;
+
+	return 0;
+}
+
+/***************************************************************************
+ * @brief API used to delete/free the session info from the session list.
+ * @param sessionId is used to represent the session.
+ * @return 0 upon success else returns -1.
+ ***************************************************************************/
+static int free_session_info(unsigned int sessionId)
+{
+	struct session_t *current = head_session, *previous;
+
+	if (head_session == NULL)
+	{
+		printf("%s:%d Error : Invalid  Session!!!\n",__FILE__,__LINE__);
+		return -1;
+	}
+
+	if (current->session_id == sessionId)
+	{
+		head_session = current->next;
+		close(current->fd);
+		free(current->rootDir);
+		free(current);
+		return 0;
+	}
+
+	while (current != NULL && current->session_id != sessionId)
+	{
+		previous = current;
+		current = current->next;
+	}
+
+	if (current == NULL)
+	{
+		printf("%s:%d Session info not found \n",__FILE__,__LINE__);
+		return -1;
+	}
+	previous->next = current->next;
+	close(current->fd);
+	free(current->rootDir);
+	free(current);
+
+	return 0;
+}
+
+/***************************************************************************
+ * @brief API used to remove the last character '/' from application secure directory path.
+ * @param str indicates application secure directory path.
+ * @return None.
+ ***************************************************************************/
+static void remove_last_slash_char(char *str)
+{
+	char *temp = NULL;
+
+	if(str == NULL)
+	{
+		return;
+	}
+
+	temp = strrchr(str,'/');
+
+	if(temp == NULL)
+	{
+		return;
+	}
+
+	if (strlen(temp) == 1 && strlen(str) > 1)
+	{
+		str[strlen(str) -1] = '\0';
+	}
+}
+
+/***************************************************************************
+ * @brief API used to get the application secure directory path based on session id.
+ * @param sessionId indicates session info.
+ * @return application secure directory path upon success else returns a NULL.
+ ***************************************************************************/
+static char *get_application_path(unsigned int sessionId)
+{
+	struct session_t *ptr = head_session;
+
+	while(ptr != NULL)
+	{
+		if(ptr->session_id == sessionId)
+		{
+			return ptr->rootDir;
+		}
+		ptr = ptr->next;
+	}
+
+	return NULL;
+}
