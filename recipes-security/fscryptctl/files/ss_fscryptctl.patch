+/***************************************************************************
+ * @brief API used to delete the directory/file from the root directory.
+ *
+ * @prerequisite            : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstxSSDeleteDataInfo : Address of SS Delete data Info structure which contains below params,
+ * @in uintxSessionId       : secure storage session id
+ *
+ * @in stDomain             : relative path from app root directory.
+ *                              If stDomain.data == NULL, will delete the file data from stAppRootPath directory
+ *                              If stDomain.data != NULL, will delete the file data from the specified directory
+ *                                Ex: youtube             ==> secure storage path (stAppRootPath)
+ *                                    sample1             ==> domain path (stDomain)
+ *                                    youtube/sample1     ==> path to delete the file data if stDomain valid
+ *                                    youtube             ==> path to delete the file data if stDomain NULL
+ *                             stDomain.size => size of the data
+ *
+ * @in stKey                : file name to delete the data. it must be valid.
+ *                            stKey.data -> file name.
+ *                            stKey.size -> size of the data
+ *                              If stDomain.data == NULL & stKey.data != NULL, will delete the file from stAppRootPath
+ *                              If stDomain.data != NULL & stKey.data != NULL, will delete the file from specified directory
+ *                              If stDomain.data != NULL & stKey.data == NULL, will delete the file from specified directory
+ *                              If stDomain.data == NULL & stKey.data == NULL, will return RDK_SS_ERROR_INVALID_INPUT error
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_deleteData (RDK_SS_DELETE_DATA_INFO_STRUCT *pstxSSDeleteDataInfo)
+{
+    struct fscrypt_delete_file_arg arg = {0};
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+    int fd     = -1;
+    int ret    = -1;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(NULL == pstxSSDeleteDataInfo)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pstxSSDeleteDataInfo is NULL\n");
+            break;
+        }
+
+        if(RDK_SS_SESSION_ID_RANGE_MIN > pstxSSDeleteDataInfo->uintSessionId
+           || RDK_SS_SESSION_ID_RANGE_MAX < pstxSSDeleteDataInfo->uintSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("Invalid uintSessionId [%u]\n", pstxSSDeleteDataInfo->uintSessionId);
+            break;
+        }
+
+        if(NULL == pstxSSDeleteDataInfo->stDomain.data
+           && NULL == pstxSSDeleteDataInfo->stKey.data)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stDomain.data & stKey.data both are NULL\n");
+            break;
+        }
+
+        if(NULL != pstxSSDeleteDataInfo->stDomain.data
+           && 0 == pstxSSDeleteDataInfo->stDomain.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stDomain.data is valid but stDomain.size is 0\n");
+            break;
+        }
+
+        if(NULL == pstxSSDeleteDataInfo->stDomain.data
+           && 0 != pstxSSDeleteDataInfo->stDomain.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stDomain.data is NULL but stDomain.size is valid\n");
+            break;
+        }
+
+        if(NULL != pstxSSDeleteDataInfo->stKey.data
+           && 0 == pstxSSDeleteDataInfo->stKey.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stKey.data is valid but stKey.size is 0\n");
+            break;
+        }
+
+        if(NULL == pstxSSDeleteDataInfo->stKey.data
+           && 0 != pstxSSDeleteDataInfo->stKey.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stKey.data is NULL but stKey.size is valid\n");
+            break;
+        }
+
+        if(NULL != pstxSSDeleteDataInfo->stDomain.data)
+        {
+            remove_last_slash_char(pstxSSDeleteDataInfo->stDomain.data);
+        }
+
+        arg.session_id      = pstxSSDeleteDataInfo->uintSessionId;
+        arg.stDomain.data   = pstxSSDeleteDataInfo->stDomain.data;
+        arg.stDomain.size   = pstxSSDeleteDataInfo->stDomain.size;
+
+        arg.stKey.data      = pstxSSDeleteDataInfo->stKey.data;
+        arg.stKey.size      = pstxSSDeleteDataInfo->stKey.size;
+
+        fd = get_fileDesc(pstxSSDeleteDataInfo->uintSessionId);
+        if(fd < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("fd is not found for the given sessionId %u\n", pstxSSDeleteDataInfo->uintSessionId);
+            break;
+        }
+
+        ret = ioctl(fd, FS_IOC_DELETE_DATA, &arg);
+        if (ret != 0)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno,pstxSSDeleteDataInfo->uintSessionId);
+            printf("[ioctl] delete data call failed. sessionId %u eErrorCode %u\n",
+                                            pstxSSDeleteDataInfo->uintSessionId,
+                                            eErrorCode);
+            break;
+        }
+
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    return eErrorCode;
+}
