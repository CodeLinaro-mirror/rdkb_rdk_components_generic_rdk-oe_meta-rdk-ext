+#ifndef _SS_FSCRYPTCTL_H
+#define _SS_FSCRYPTCTL_H
+
+/* Include Files */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
