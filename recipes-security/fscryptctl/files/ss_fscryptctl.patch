+#ifndef __SECURE_STORAGE_H
+#define __SECURE_STORAGE_H
+
+/************************** MACROS ********************************************/
+#define RDK_SS_MASTER_KEY_SIZE    64
+#define RDK_SS_VERSION_SIZE       20
+
+/************************** Stucture & Enum ***********************************/
+/* Secure Storage Error Codes */
+typedef enum
+{
+    RDK_SS_ERROR_SUCCESS            = 0,
+    RDK_SS_ERROR_FAILURE,
+    RDK_SS_ERROR_INVALID_INPUT,
+    RDK_SS_ERROR_NO_MODULE_INIT,
+    RDK_SS_ERROR_MEM_ALLOCATION,
+    RDK_SS_ERROR_NOT_ENOUGH_MEMORY
+}RDK_SS_ERROR_ENUM;
+
+/* Secure Storage file mode operation */
+typedef enum {
+    RDK_SS_FILE_MODE_WRITE          = 0,
+    RDK_SS_FILE_MODE_APPEND
+}RDK_SS_FILE_MODE_ENUM;
+
+typedef struct {
+    void* data;
+    unsigned int size;
+}TRdkStringData;
+
+typedef TRdkStringData TRdkBufferData;
+
+typedef struct {
+    TRdkStringData stDevicePath;
+}RDK_SS_INIT_INFO_STRUCT;
+
+typedef struct {
+    TRdkStringData stAppRootPath;
+    char acMasterKey[RDK_SS_MASTER_KEY_SIZE];
+    unsigned int   uintSessionId;
+}RDK_SS_OPENSESSION_INFO_STRUCT;
+
+typedef struct {
+    unsigned int   uintSessionId;
+    TRdkStringData stDomain;
+    TRdkStringData stKey;
+    TRdkBufferData stData;
+}RDK_SS_READ_DATA_INFO_STRUCT;
+
+typedef struct {
+    unsigned int   uintSessionId;
+    TRdkStringData stDomain;
+    TRdkStringData stKey;
+    TRdkBufferData stData;
+    RDK_SS_FILE_MODE_ENUM eFileMode
+}RDK_SS_WRITE_DATA_INFO_STRUCT;
+
+typedef struct {
+    unsigned int   uintSessionId;
+}RDK_SS_CLOSESESSION_INFO_STRUCT;
+
+typedef struct {
+    unsigned int   uintSessionId;
+    TRdkStringData stDomain;
+    TRdkStringData stKey;
+}RDK_SS_DELETE_DATA_INFO_STRUCT;
+
+/* Secure Storage function pointers */
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSInit) ( RDK_SS_INIT_INFO_STRUCT *pstSSInitInfo );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSOpenSession) ( RDK_SS_OPENSESSION_INFO_STRUCT *pstSSOpenSessionIfo );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSReadData) ( RDK_SS_READ_DATA_INFO_STRUCT *pstSSReadDataInfo );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSWriteData) ( RDK_SS_WRITE_DATA_INFO_STRUCT *pstSSWriteDataInfo );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSCloseSession) ( RDK_SS_CLOSESESSION_INFO_STRUCT *pstSSCloseSessionInfo );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSDeleteData) ( RDK_SS_DELETE_DATA_INFO_STRUCT *pstSSDeleteDataInfo );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSTerminate) ( void );
+
+/* Secure Storage structure which holds the version value and supported function pointer */
+typedef struct {
+    unsigned char        acSSVersionString[ RDK_SS_VERSION_SIZE ];
+    fpRdkSSInit          rdk_ss_init;
+    fpRdkSSOpenSession   rdk_ss_openSession;
+    fpRdkSSReadData      rdk_ss_readData;
+    fpRdkSSWriteData     rdk_ss_writeData;
+    fpRdkSSCloseSession  rdk_ss_closeSession;
+    fpRdkSSDeleteData    rdk_ss_deleteData;
+    fpRdkSSTerminate     rdk_ss_terminate;
+}RDK_SS_FUNCTION_STRUCT;
+
+/************************** Function Prototypes *******************************/
+
+/***************************************************************************
+ * @brief API used to get the secure storage supported function pointer. This function must be called before calling
+ *        any other secure storage functions.
+ *
+ * @prerequisite             : None
+ *
+ * @out ppSSFunctionStruct   : double pointer which holds the address of RDK_SS_FUNCTION_STRUCT.
+ *                              using this pointer, user can call the other SS supported functions ( rdk_ss_init,
+ *                              rdk_ss_openSession, rdk_ss_readData, rdk_ss_writeData, rdk_ss_closeSession,
+ *                              rdk_ss_deleteData and rdk_ss_terminate)
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_INVALID_INPUT if invalid input
+ *         RDK_SS_ERROR_FAILURE if any error
+ ***************************************************************************/
+
+RDK_SS_ERROR_ENUM rdk_ss_getFunction ( RDK_SS_FUNCTION_STRUCT** ppSSFunctionStruct );
+
+/***************************************************************************
+ * @brief API used to Initialize the Secure Storage functionalities and allocate required resource and/or memory if need.
+ *        This function should be called once after the device bootup.
+ *
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstSSInitInfo    : Address of SS Init Info structure which contains the below params,
+ *                        stDevicePath.data => Device Path name. Ex:- "/opt/secure"
+ *                        stDevicePath.size => size of the data
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_MEM_ALLOCATION if memory allocation failed
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_init ( RDK_SS_INIT_INFO_STRUCT *pstSSInitInfo );
+
+/***************************************************************************
+ * @brief API used to create the unique ciphering key and protect the stAppRootPath.
+ *        Returns the session handle as sessionId.
+ *
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstSSOpenSessionIfo   : Address of SS Open Session Info structure which contains below params,
+ * @in  acMasterKey          : Array of 64 Byte Key.
+ *                              If acMasterKey is valid, will generate the ciphering key using acMasterKey
+ *                              If acMasterKey is NULL, internally will generate the unique ciphering key
+ * @in  stAppRootPath        : directory path in which the user want to keep the files as encrypted.
+ *                              stAppRootPath.data => Application directory path
+ *                                Ex:-
+ *                                  youtube                  -> Valid
+ *                                  youtube/secure_dir       -> Valid
+ *                                  youtube/secure_dir/test1 -> Valid
+ *                              stAppRootPath.size => size of the data
+ *
+ * @out uintSessionId        : returns the secure storage session id
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ *         RDK_SS_ERROR_MEM_ALLOCATION if memory allocation failed
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_openSession ( RDK_SS_OPENSESSION_INFO_STRUCT *pstSSOpenSessionIfo );
+
+/***************************************************************************
+ * @brief API used to write the data into the encrypted directory.
+ *
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstSSWriteDataInfo    : Address of SS WriteData Session Info structure which contains below params,
+ * @in uintSessionId         : secure storage session id
+ *
+ * @in stDomain              : Relative path from app root directory.
+ *                              If stDomain.data == NULL, will write the data into stAppRootPath directory
+ *                              If stDomain.data != NULL, will write the data into the specified directory
+ *                                Ex: youtube             ==> secure storage path (stAppRootPath)
+ *                                    sample1             ==> domain path (stDomain)
+ *                                    youtube/sample1     ==> path to write the data if stDomain valid
+ *                                    youtube             ==> path to write the data if stDomain NULL
+ *                             stDomain.size -> size of the data
+ * @in stKey                 : file name to write the data. It must be valid.
+ *                             stKey.data -> file name.
+ *                             stKey.size -> size of the data
+ *
+ * @in/out stData            : buffer data to write into file. It must be valid.
+ *                           : stData.data -> buffer to write into file.
+ *                             stData.size -> size of the data
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_writeData ( RDK_SS_WRITE_DATA_INFO_STRUCT *pstSSWriteDataInfo );
+
+/***************************************************************************
+ * @brief API used to read the file from the encrypted directory.
+ *
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstSSReadDataInfo     : Address of SS ReadData Session Info structure which contains below params,
+ * @in uintSessionId         : secure storage session id
+ *
+ * @in stDomain              : Relative path from the stAppRootPath directory.
+ *                              If stDomain.data == NULL, will read the file from stAppRootPath directory
+ *                              If stDomain.data != NULL, will read the file from the specified directory
+ *                                Ex: youtube             ==> secure storage path (stAppRootPath)
+ *                                    sample1             ==> domain path (stDomain)
+ *                                    youtube/sample1     ==> path to read the file if stDomain valid
+ *                                    youtube             ==> path to read the file if stDomain NULL
+ *                              stDomain.size -> size of the data
+ *
+ * @in stKey                 : File name to read. It must be valid.
+ *                             stKey.data -> file name.
+ *                             stKey.size -> size of the data
+ *
+ * @in/out stData            : Buffer to copy the data from file.
+ *                           : stData.data => buffer to copy data.
+ *                             stData.size => size of the data
+ *                               In below cases, fileSize will be return in stData.size.
+ *                                 1. If stData.size >= fileSize
+ *                                 2. If stData.size < fileSize
+ *                                 3. If stData.data == NULL & stData.size == 0
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ *         RDK_SS_ERROR_NOT_ENOUGH_MEMORY if the given buffer does not have enough memory to read file.
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_readData ( RDK_SS_READ_DATA_INFO_STRUCT *pstSSReadDataInfo );
+
+/***************************************************************************
+ * @brief API used to delete the directory/file from the root directory.
+ *
+ * @prerequisite            : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstSSDeleteDataInfo  : Address of SS Delete data Info structure which contains below params,
+ * @in uintxSessionId       : secure storage session id
+ *
+ * @in stDomain             : relative path from app root directory.
+ *                              If stDomain.data == NULL, will delete the file data from stAppRootPath directory
+ *                              If stDomain.data != NULL, will delete the file data from the specified directory
+ *                                Ex: youtube             ==> secure storage path (stAppRootPath)
+ *                                    sample1             ==> domain path (stDomain)
+ *                                    youtube/sample1     ==> path to delete the file data if stDomain valid
+ *                                    youtube             ==> path to delete the file data if stDomain NULL
+ *                             stDomain.size => size of the data
+ *
+ * @in stKey                : file name to delete the data. it must be valid.
+ *                            stKey.data -> file name.
+ *                            stKey.size -> size of the data
+ *                              If stDomain.data == NULL & stKey.data != NULL, will delete the file from stAppRootPath
+ *                              If stDomain.data != NULL & stKey.data != NULL, will delete the file from specified directory
+ *                              If stDomain.data != NULL & stKey.data == NULL, will delete the file from specified directory
+ *                              If stDomain.data == NULL & stKey.data == NULL, will return RDK_SS_ERROR_INVALID_INPUT error
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_deleteData ( RDK_SS_DELETE_DATA_INFO_STRUCT *pstSSDeleteDataInfo );
+
+/***************************************************************************
+ * @brief API used to remove the opened session.
+ *
+ * @prerequisite              : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstSSCloseSessionInfo  : Address of SS Close Session Info structure which contains below params,
+ * @in/out uintSessionId      : secure storage session id
+ *                              it will be return as 0 if the session closed successfully.
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_closeSession ( RDK_SS_CLOSESESSION_INFO_STRUCT *pstSSCloseSessionInfo );
+
+/***************************************************************************
+ * @brief API used to cleanup the SS initialization function. This function should be called once before the device shutdown.
+ *
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_terminate ( void );
+
+#endif /* __SECURE_STORAGE_H */
