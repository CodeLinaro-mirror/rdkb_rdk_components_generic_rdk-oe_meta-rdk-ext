+/***************************************************************************
+ * @brief API used to Initialize the Secure Storage functionalities and allocate required resource and/or memory if need.
+ *        This function should be called once after the device bootup.
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_FAILURE if any error 
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_init ( void )
+{
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_SUCCESS;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            gsbRdkSSInitialization = TRUE;
+        }
+        else
+        {
+            printf("Already Secure storage module initialized\n");
+        }
+        break;
+    }
+
+    return eErrorCode;
+}
+
+/***************************************************************************
+ * @brief API used to Terminate the Secure Storage functionalities and release the used resources
+ *        and memory. This function should be called once before the device shutdown.
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_terminate ( void )
+{
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_SUCCESS;
+
+    for(;;)
+    {    
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        /* To DO: Need to handle the multi-instance use case */
+
+        if(gsbRdkSSInitialization)
+        {
+            gsbRdkSSInitialization = FALSE;
+        }
+        break;
+    }
+
+    return eErrorCode;
+}
+
+/***************************************************************************
+ * @brief API used to remove the session handle.
+ * @prerequisite       : rdk_ss_getFunction() call should be successful.
+ * @in/out pxSessionId : handle to indentify the session.
+ *                       it will be returned as 0 if the session closed successfully.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error 
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_closeSession (unsigned int *pxSessionId)
+{
+    struct fscrypt_close_session_arg closeSessionarg = {0};
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+    int fd  = -1;
+    int ret = -1;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(NULL == pxSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pxSessionId is NULL\n");
+            break;
+        }
+
+        if(RDK_SS_SESSION_ID_RANGE_MIN > *pxSessionId || RDK_SS_SESSION_ID_RANGE_MAX < *pxSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("Invalid uintxSessionId [%u]\n", *pxSessionId);
+            break;
+        }
+
+        fd = get_fileDesc(*pxSessionId);
+        if(fd < 0)
+        {
+            eErrorCode =  RDK_SS_ERROR_FAILURE;
+            printf("fd is not found for the given sessionId %u\n", *pxSessionId);
+            break;
+        }
+
+        closeSessionarg.session_id = *pxSessionId;
+
+        ret = ioctl(fd, FS_IOC_CLOSE_SESSION, &closeSessionarg);
+        if (ret != 0)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno,*pxSessionId);
+            printf("[ioctl] close session call failed. sessionId %u eErrorCode %u\n", *pxSessionId, eErrorCode);
+            break;
+        }
+
+        ret = free_session_info(*pxSessionId);
+        if (ret < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("Failed to free the session info\n");
+            break;
+        }
+
+        *pxSessionId = RDK_SS_INVALID_SESSION_ID;
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    return eErrorCode;
+}
