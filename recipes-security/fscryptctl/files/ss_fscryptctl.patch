+/* Session id range */
+#define RDK_SS_SESSION_ID_RANGE_MIN     1000
+#define RDK_SS_SESSION_ID_RANGE_MAX     100000
+#define RDK_SS_INVALID_SESSION_ID       0
+
+/* Set Policy inputs */
+#define FSCRYPT_PADDING      "padding:"
+#define FSCRYPT_CONTENTS     "contents:"
+#define FSCRYPT_FILENAMES    "filenames:"
+#define FSCRYPT_KEY_IDENTIFIER_SIZE    16
+#define FSCRYPT_POLICY_V2        2
+
+/* Encryption Modes */
+#define FSCRYPT_MODE_AES_256_XTS                1
+#define FSCRYPT_MODE_AES_256_CTS                4
+#define FSCRYPT_MODE_AES_128_CBC                5
+#define FSCRYPT_MODE_AES_128_CTS                6
+#define FSCRYPT_MODE_SM4_XTS                    7
+#define FSCRYPT_MODE_SM4_CTS                    8
+#define FSCRYPT_MODE_ADIANTUM                   9
+#define FSCRYPT_MODE_AES_256_HCTR2              10
+
+/* Encryption policy flags */
+#define FSCRYPT_POLICY_FLAGS_PAD_4             0x00
+#define FSCRYPT_POLICY_FLAGS_PAD_8             0x01
+#define FSCRYPT_POLICY_FLAGS_PAD_16            0x02
+#define FSCRYPT_POLICY_FLAGS_PAD_32            0x03
+#define FSCRYPT_POLICY_FLAGS_PAD_MASK          0x03
+#define FSCRYPT_POLICY_FLAG_DIRECT_KEY         0x04
+#define FSCRYPT_POLICY_FLAG_IV_INO_LBLK_64     0x08
+#define FSCRYPT_POLICY_FLAG_IV_INO_LBLK_32     0x10
+
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+#define DIR_MODE    0700
+
+#ifndef TRUE
+#define TRUE        1
+#endif
+
+#ifndef FALSE
+#define FALSE        0
+#endif
+
+#define RDK_SS_VERSION     "1.0.0"
+
+/* Session information structure */
+struct session_t {
+    int fd;
+    char *rootDir;
+    unsigned int session_id;
+    struct session_t *next;
+};
+
+/* Policy structure */
+struct fscrypt_policy_v2 {
+    unsigned char version;
+    unsigned char contents_encryption_mode;
+    unsigned char filenames_encryption_mode;
+    unsigned char flags;
+    unsigned char __reserved[4];
+    unsigned char master_key_identifier[FSCRYPT_KEY_IDENTIFIER_SIZE];
+};
+
+/* Struct passed to FS_IOC_OPEN_SESSION */
+struct fscrypt_open_session_arg {
+    char master_key[RDK_SS_MASTER_KEY_SIZE];
+    char *root_dir;
+    struct fscrypt_policy_v2 policy;
+    unsigned int session_id;
+};
+/* Struct passed to FS_IOC_CLOSE_SESSION */
+struct fscrypt_close_session_arg {
+    unsigned int session_id;
+};
+
+/* Struct passed to FS_IOC_READ_ENCRYPTION_FILE_DATA/FS_IOC_WRITE_ENCRYPTION_FILE_DATA */
+struct fscrypt_data_arg {
+    unsigned char *domain;
+    unsigned char *key;
+    unsigned char *data;
+    int data_len;
+    RDK_SS_FILE_MODE_ENUM file_mode;
+    unsigned int session_id;
+};
+
+/* Struct passed to FS_IOC_DELETE_DATA */
+struct fscrypt_delete_file_arg {
+    unsigned char *domain;
+    unsigned char *key;
+    unsigned int session_id;
+};
+
+/* IOCTL commands */
+#define FS_IOC_OPEN_SESSION                    _IOWR('f', 28, struct fscrypt_open_session_arg)
+#define FS_IOC_READ_ENCRYPTION_FILE_DATA       _IOWR('f', 29, struct fscrypt_data_arg)
+#define FS_IOC_WRITE_ENCRYPTION_FILE_DATA      _IOWR('f', 30, struct fscrypt_data_arg)
+#define FS_IOC_CLOSE_SESSION                   _IOWR('f', 31, struct fscrypt_close_session_arg)
+#define FS_IOC_DELETE_DATA                     _IOR('f', 32, struct fscrypt_delete_file_arg)
+
+#endif /* _SS_FSCRYPTCTL_H */
