+/***************************************************************************
+ * @brief API used to remove the opened session.
+ *
+ * @prerequisite              : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstxSSCloseSessionInfo : Address of SS Close Session Info structure which contains below params,
+ * @in/out uintSessionId      : secure storage session id
+ *                              it will be return as 0 if the session closed successfully.
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_closeSession (RDK_SS_CLOSESESSION_INFO_STRUCT *pstxSSCloseSessionInfo)
+{
+    struct fscrypt_close_session_arg closeSessionarg = {0};
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+    int fd  = -1;
+    int ret = -1;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(NULL == pstxSSCloseSessionInfo)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pstxSSCloseSessionInfo is NULL\n");
+            break;
+        }
+
+        if(RDK_SS_SESSION_ID_RANGE_MIN > pstxSSCloseSessionInfo->uintSessionId
+            || RDK_SS_SESSION_ID_RANGE_MAX < pstxSSCloseSessionInfo->uintSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("Invalid uintxSessionId [%u]\n", pstxSSCloseSessionInfo->uintSessionId);
+            break;
+        }
+
+        fd = get_fileDesc(pstxSSCloseSessionInfo->uintSessionId);
+        if(fd < 0)
+        {
+            eErrorCode =  RDK_SS_ERROR_FAILURE;
+            printf("fd is not found for the given sessionId %u\n", pstxSSCloseSessionInfo->uintSessionId);
+            break;
+        }
+
+        closeSessionarg.session_id = pstxSSCloseSessionInfo->uintSessionId;
+
+        ret = ioctl(fd, FS_IOC_CLOSE_SESSION, &closeSessionarg);
+        if (ret != 0)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno,pstxSSCloseSessionInfo->uintSessionId);
+            printf("[ioctl] close session call failed. sessionId %u eErrorCode %u\n",
+                                            pstxSSCloseSessionInfo->uintSessionId,
+                                            eErrorCode);
+            break;
+        }
+
+        ret = free_session_info(pstxSSCloseSessionInfo->uintSessionId);
+        if (ret < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("Failed to free the session info\n");
+            break;
+        }
+
+        pstxSSCloseSessionInfo->uintSessionId = RDK_SS_INVALID_SESSION_ID;
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    return eErrorCode;
+}
+
+/***************************************************************************
+ * @brief API used to cleanup the SS initialization function. This function should be called once before the device shutdown.
+ *
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_terminate ( void )
+{
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(NULL != gsstSSDevicePath.data)
+        {
+            free(gsstSSDevicePath.data);
+            gsstSSDevicePath.data = NULL;
+            gsstSSDevicePath.size = 0;
+        }
+        /* To DO: Need to handle the multi-instance use case */
+
+        if(gsbRdkSSInitialization)
+        {
+            gsbRdkSSInitialization = FALSE;
+        }
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    return eErrorCode;
+}
