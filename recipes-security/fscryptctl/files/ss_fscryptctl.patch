+/***************************************************************************
+ * @brief API used to write the file data from the encrypted directory.
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ * @in uintxSessionId    : handle to identify the secure storage session
+ * @in pxDomain          : relative path from the root directory from where we have to write file.
+ *                          If pxDomain NULL, will write the file in pxAppRootPath directory
+ *                          If pxDomain Valid, will write the file in the specified pDomain directory
+ *                               Ex: youtube/secure_dir ==> secure storagepath (pxAppRootPath)
+ *                                   sample1            ==> domain path (pxDomain)
+ *                                youtube/secure_dir/sample1 ==> path to write the file if pxDomain valid
+ *                                youtube/secure_dir         ==> path to write the file if pxDomain NULL
+ * @in pxKey             : file name to write the data. it must be valid.
+ * @in pxDataBuffer      : data buffer to write in file.
+ * @in xDataBufferSize   : size of the given pxDataBuffer.
+ * @in exFileMode        : Mode of file operation. It can be RDK_SS_FILE_MODE_WRITE or
+ *                         RDK_SS_FILE_MODE_APPEND
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_writeData (unsigned int uintxSessionId,
+                                    char *pxDomain,
+                                    char *pxKey,
+                                    unsigned char *pxDataBuffer,
+                                    unsigned int xDataBufferSize,
+                                    RDK_SS_FILE_MODE_ENUM exFileMode)
+{
+    struct fscrypt_data_arg arg     = {0};
+    RDK_SS_ERROR_ENUM eErrorCode    = RDK_SS_ERROR_FAILURE;
+    int fd     = -1;
+    int ret    = -1;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(RDK_SS_SESSION_ID_RANGE_MIN > uintxSessionId || RDK_SS_SESSION_ID_RANGE_MAX < uintxSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("Invalid uintxSessionId [%u]\n", uintxSessionId);
+            break;
+        }
+
+        if(NULL == pxDataBuffer)
+        {
+            printf("pxDataBuffer is NULL\n");
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            break;
+        }
+
+        if(NULL == pxKey)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pxKey is NULL\n");
+            break;
+        }
+
+        if(0 == xDataBufferSize)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("xDataBufferSize is zero\n");
+            break;
+        }
+
+        if(RDK_SS_FILE_MODE_WRITE != exFileMode
+        && RDK_SS_FILE_MODE_APPEND != exFileMode)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("exFileMode [%u] is invalid \n", exFileMode);
+            break;
+        }
+
+        remove_last_slash_char(pxDomain);
+
+        arg.session_id     = uintxSessionId;
+        arg.domain         = pxDomain;
+        arg.key            = pxKey;
+        arg.data           = pxDataBuffer;
+        arg.data_len       = xDataBufferSize;
+        arg.file_mode      = exFileMode;
+
+        fd = get_fileDesc(uintxSessionId);
+        if(fd < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("fd is not found for the given sessionId %u\n", uintxSessionId);
+            break;
+        }
+
+        ret = ioctl(fd, FS_IOC_WRITE_ENCRYPTION_FILE_DATA, &arg);
+        if (0 != ret)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno,uintxSessionId);
+            printf("[ioctl] write data call failed. sessionId %u eErrorCode %u\n", uintxSessionId, eErrorCode);
+            break;
+        }
+
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+    return eErrorCode;
+}
