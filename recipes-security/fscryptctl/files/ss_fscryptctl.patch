+/***************************************************************************
+ * @brief API used to create the unique ciphering key and protect the pxAppRootPath folder in where will store the files
+ *        and return the pxSessionId as a handle.
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ * @in  acxMasterKey         : Array of 64 Byte Key.
+ *                              If acxMasterKey is valid, will be used to generate the key to protect the files
+ *                              If acxMasterKey is NULL, internally will generate the key to protect the files
+ * @in  pxAppRootPath        : directory path in which the user want to keep the files as encrypted.
+ *                             This path must have minimum one sub-folder to get valid mountpoint.
+ *                             youtube/secure_dir       -> Valid
+ *                             youtube/secure_dir/test1 -> Valid
+ *                             youtube                  -> Invalid
+ *                                  Ex1: youtube/secure_dir  ==> secure storagepath (pxAppRootPath)
+ *                                       youtube             ==> secure directory mount path (mountpoint)
+ *                                  Ex2: youtube/secure_dir/test1    ==> secure storagepath (pxAppRootPath)
+ *                                       youtube/secure_dir          ==> secure directory mount path (mountpoint)
+ * @out pxSessionId          : pointer to hold the secure storage session handle of given pxAppRootPath.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ *         RDK_SS_ERROR_MEM_ALLOCATION if memory allocation failed
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_openSession (char *acxMasterKey, char *pxAppRootPath, unsigned int *pxSessionId)
+{
+    struct fscrypt_open_session_arg openSessionarg = {0};
+    char *mountpoint     = NULL;
+    char *temp_path        = NULL;
+    unsigned int sessionId = 0;
+    int len    = 0;
+    int fd     = -1;
+    int ret    = -1;
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+    unsigned char contents_encryption_mode;
+    unsigned char filenames_encryption_mode;
+    unsigned char padding_flags;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(NULL == pxAppRootPath)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pxAppRootPath is NULL\n");
+            break;
+        }
+
+        temp_path = strrchr(pxAppRootPath,'/');
+        if (NULL == temp_path)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pxAppRootPath is invalid [%s]\n", pxAppRootPath);
+            break;
+        }
+
+        if(NULL == pxSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pxSessionId is NULL\n");
+            break;
+        }
+        *pxSessionId = RDK_SS_INVALID_SESSION_ID;
+
+        remove_last_slash_char(pxAppRootPath);
+
+        ret = is_session_exist(pxAppRootPath,&sessionId);
+        if (ret == 0)
+        {
+            *pxSessionId = sessionId;
+            eErrorCode = RDK_SS_ERROR_SUCCESS;
+            printf("Session[%u] already Exist!!!\n",pxSessionId);
+            break;
+        }
+
+        ret = check_and_create_dir(pxAppRootPath);
+        if (ret < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("Path creation is falied for [%s] errorno[%u]\n", pxAppRootPath, errno);
+            break;
+        }
+
+        if (check_ownership_capability(pxAppRootPath)== RDK_SS_ERROR_FAILURE)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            break;
+        }
+
+        ret = get_fscrypt_encryption_mode(&contents_encryption_mode, &filenames_encryption_mode, &padding_flags);
+        if (ret < 0)
+        {
+            contents_encryption_mode  = FSCRYPT_MODE_AES_256_XTS;
+            filenames_encryption_mode = FSCRYPT_MODE_AES_256_CTS;
+            padding_flags = FSCRYPT_POLICY_FLAGS_PAD_32;
+        }
+
+        openSessionarg.policy.flags       = padding_flags;
+        memcpy(openSessionarg.master_key, acxMasterKey, RDK_SS_MASTER_KEY_SIZE);
+        openSessionarg.root_dir           = pxAppRootPath;
+        openSessionarg.policy.version     = FSCRYPT_POLICY_V2;
+        openSessionarg.policy.contents_encryption_mode     = contents_encryption_mode;
+        openSessionarg.policy.filenames_encryption_mode    = filenames_encryption_mode;
+
+        /* Secure directory mount path is called mountpoint
+        * Ex: /opt/secure/netflix/secure_dir ==> secure storagepath (pxAppRootPath)
+        *     /opt/secure/netflix            ==> secure directory mount path (mountpoint)
+        */
+
+        mountpoint = (char *)malloc(strlen(pxAppRootPath));
+        if (mountpoint == NULL)
+        {
+            eErrorCode = RDK_SS_ERROR_MEM_ALLOCATION;
+            printf("Memory alloc failed size [%u]\n",strlen(pxAppRootPath));
+            break;
+        }
+
+        len = strlen(pxAppRootPath)-strlen(temp_path);
+        strncpy(mountpoint, pxAppRootPath,len);
+        mountpoint [len++] = '\0';
+
+        fd = open(mountpoint, O_RDONLY | O_CLOEXEC);
+        if (fd < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("Path mount[%s] is Failure\n", mountpoint);
+            break;
+        }
+
+        ret = ioctl(fd, FS_IOC_OPEN_SESSION, &openSessionarg);
+        if (ret != 0)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno,openSessionarg.session_id);
+            printf("[ioctl] Open session call failed. retun value %u\n", ret);
+            break;
+        }
+
+        *pxSessionId = openSessionarg.session_id;
+
+        ret = insert_session_info(fd, pxAppRootPath, *pxSessionId);
+        if(ret != 0 )
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("Insert_session info is Failed. session id %u\n", openSessionarg.session_id);
+        }
+
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    if(NULL != mountpoint)
+    {
+        free(mountpoint);
+        mountpoint = NULL;
+    }
+
+    return eErrorCode;
+}
+
+/***************************************************************************
+ * @brief API used to delete the directory/file from the root directory.
+ * @prerequisite          : rdk_ss_getFunction() call should be successful.
+ * @in uintxSessionId     : represent the session.
+ * @in pxDomain           : relative path from root directory.
+ *                          If pxDomain NULL and key valid, will search and delete the file from root directory
+ *                          If pxDomain and key both valid, will search and delete the file from specified directory
+ *                          If pxDomain valid and key NULL, will search and delete the file from specified directory
+ *                          If pxDomain and key both NULL, will return RDK_SS_ERROR_INVALID_INPUT error.
+ * @in pxKey              : name of the file.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_deleteData (unsigned int uintxSessionId, char *pxDomain, char *pxKey)
+{
+    struct fscrypt_delete_file_arg arg = {0};
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+    int fd     = -1;
+    int ret    = -1;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(RDK_SS_SESSION_ID_RANGE_MIN > uintxSessionId || RDK_SS_SESSION_ID_RANGE_MAX < uintxSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("Invalid uintxSessionId [%u]\n", uintxSessionId);
+            break;
+        }
+
+        if(NULL == pxKey)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pxKey is NULL\n");
+            break;
+        }
+
+        remove_last_slash_char(pxDomain);
+
+        arg.session_id     = uintxSessionId;
+        arg.domain         = pxDomain;
+        arg.key            = pxKey;
+
+        fd = get_fileDesc(uintxSessionId);
+        if(fd < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("fd is not found for the given sessionId %u\n", uintxSessionId);
+            break;
+        }
+
+        ret = ioctl(fd, FS_IOC_DELETE_DATA, &arg);
+        if (ret != 0)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno,uintxSessionId);
+            printf("[ioctl] delete data call failed. sessionId %u eErrorCode %u\n", uintxSessionId, eErrorCode);
+            break;
+        }
+
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    return eErrorCode;
+}
