+#ifndef __SECURE_STORAGE_H
+#define __SECURE_STORAGE_H
+
+#define RDK_SS_MASTER_KEY_SIZE    64
+#define RDK_SS_VERSION_SIZE       20
+
+/* Secure Storage Error Codes */
+typedef enum
+{
+    RDK_SS_ERROR_SUCCESS            = 0,
+    RDK_SS_ERROR_FAILURE,
+    RDK_SS_ERROR_INVALID_INPUT,
+    RDK_SS_ERROR_NO_MODULE_INIT,
+    RDK_SS_ERROR_MEM_ALLOCATION,
+    RDK_SS_ERROR_NOT_ENOUGH_MEMORY
+}RDK_SS_ERROR_ENUM;
+
+/* Secure Storage file mode operation */
+typedef enum {
+    RDK_SS_FILE_MODE_WRITE          = 0,
+    RDK_SS_FILE_MODE_APPEND
+}RDK_SS_FILE_MODE_ENUM;
+
+/* Secure Storage function pointers */
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSInit) ( void );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSOpenSession) ( char acxMasterKey[RDK_SS_MASTER_KEY_SIZE],
+                                             char *pxAppRootPath,
+                                             unsigned int *pxSessionId );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSReadData) ( unsigned int uintxSessionId,
+                                          char *pxDomain,
+                                          char *pxKey,
+                                          unsigned char *pxDataBuffer,
+                                          unsigned int *pxDataBufferSize );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSWriteData) ( unsigned int uintSessionId,
+                                           char *pxDomain,
+                                           char *pxKey,
+                                           unsigned char *pxDataBuffer,
+                                           unsigned int xDataBufferSize,
+                                           RDK_SS_FILE_MODE_ENUM exFileMode );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSCloseSession) ( unsigned int *pxSessionId );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSDeleteData) ( unsigned int uintxSessionId, char *pxDomain, char *pxKey );
+typedef RDK_SS_ERROR_ENUM (*fpRdkSSTerminate) ( void );
+
+/* Secure Storage structure which holds the version value and supported function pointer */
+typedef struct {
+    unsigned char        acSSVersionString[ RDK_SS_VERSION_SIZE ];
+    fpRdkSSInit          rdk_ss_init;
+    fpRdkSSOpenSession   rdk_ss_openSession;
+    fpRdkSSReadData      rdk_ss_readData;
+    fpRdkSSWriteData     rdk_ss_writeData;
+    fpRdkSSCloseSession  rdk_ss_closeSession;
+    fpRdkSSDeleteData    rdk_ss_deleteData;
+    fpRdkSSTerminate     rdk_ss_terminate;
+}RDK_SS_FUNCTION_STRUCT;
+
+/* Function protypes */
+/***************************************************************************
+ * @brief API used to Initialize the Secure Storage functionalities and allocate required resource and/or memory if need.
+ *        This function should be called once after the device bootup.
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_FAILURE if any error
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_init ( void );
+
+/***************************************************************************
+ * @brief API used to get the secure storage supported function pointer. This function must be called before calling
+ *        any other secure storage functions.
+ * @prerequisite        : None
+ * @in ppxSSFunctionStruct   : double pointer which holds the address of RDK_SS_FUNCTION_STRUCT.
+ *                              using this pointer, user can call the other SS supported functions ( rdk_ss_init,
+ *                              rdk_ss_openSession, rdk_ss_readData, rdk_ss_writeData, rdk_ss_closeSession,
+ *                              rdk_ss_deleteData and rdk_ss_terminate)
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_INVALID_INPUT if invalid input
+ *         RDK_SS_ERROR_FAILURE if any error
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_getFunction ( RDK_SS_FUNCTION_STRUCT** ppxSSFunctionStruct );
+
+/***************************************************************************
+ * @brief API used to create the unique ciphering key and protect the pxAppRootPath folder in where will store the files
+ *        and return the pxSessionId as a handle.
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ * @in  acxMasterKey         : Array of 64 Byte Key.
+ *                              If acxMasterKey is valid, will be used to generate the key to protect the files
+ *                              If acxMasterKey is NULL, internally will generate the key to protect the files
+ * @in  pxAppRootPath        : directory path in which the user want to keep the files as encrypted.
+ *                             This path must have minimum one sub-folder to get valid mountpoint.
+ *                             youtube/secure_dir       -> Valid
+ *                             youtube/secure_dir/test1 -> Valid
+ *                             youtube                  -> Invalid
+ *                               Ex1: youtube/secure_dir ==> secure storagepath (pxAppRootPath)
+ *                                    youtube             ==> secure directory mount path (mountpoint)
+ *                               Ex2: youtube/secure_dir/test1    ==> secure storagepath (pxAppRootPath)
+ *                                    youtube/secure_dir          ==> secure directory mount path (mountpoint)
+ * @out pxSessionId          : pointer to hold the secure storage session handle of given pxAppRootPath.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ *         RDK_SS_ERROR_MEM_ALLOCATION if memory allocation failed
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_openSession ( char acxMasterKey[ RDK_SS_MASTER_KEY_SIZE ], char *pxAppRootPath, unsigned int *pxSessionId );
+
+/***************************************************************************
+ * @brief API used to read the file from the encrypted directory.
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ * @in uintxSessionId        : handle to identify the secure storage session
+ * @in pxDomain              : relative path from the root directory, from where we have to read a file.
+ *                              If pxDomain NULL, will read the file in pxAppRootPath directory
+ *                              If pxDomain Valid, will read the file in the specified pxDomain directory
+ *                                Ex: youtube/secure_dir  ==> secure storagepath (pxAppRootPath)
+ *                                    sample1             ==> domain path (pxDomain)
+ *                                    youtube/secure_dir/sample1 ==> path to read the file if pxDomain valid
+ *                                    youtube/secure_dir         ==> path to read the file if pxDomain NULL
+ * @in pxKey                 : file name to read the data. it must be valid.
+ * @in/out pxDataBuffer      : buffer to copy data from file.
+ * @in/out pxDataBufferSize  : size of the given pxDataBuffer. It must be valid.
+ *                              If the pxDataBufferSize is more enough to actual file size, it will be updated with the actual file size.
+ *                              If the pxDataBufferSize is less than the actual file size, it will be updated with actual size.
+ *                                 In this case, user should call this API again with the buffer of updated pxDataBufferSize value.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ *         RDK_SS_ERROR_NOT_ENOUGH_MEMORY if given size is less the actual file size.
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_readData ( unsigned int uintxSessionId,
+                                       char *pxDomain,
+                                       char *pxKey,
+                                       unsigned char *pxDataBuffer,
+                                       unsigned int *pxDataBufferSize );
+
+/***************************************************************************
+ * @brief API used to write the file data from the encrypted directory.
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ * @in uintxSessionId    : handle to identify the secure storage session
+ * @in pxDomain          : relative path from the root directory from where we have to write file.
+ *                          If pxDomain NULL, will write the file in pxAppRootPath directory
+ *                          If pxDomain Valid, will write the file in the specified pDomain directory
+ *                            Ex: youtube/secure_dir ==> secure storagepath (pxAppRootPath)
+ *                                sample1            ==> domain path (pxDomain)
+ *                                youtube/secure_dir/sample1 ==> path to write the file if pxDomain valid
+ *                                youtube/secure_dir         ==> path to write the file if pxDomain NULL
+ * @in pxKey             : file name to write the data. it must be valid.
+ * @in pxDataBuffer      : data buffer to write in file.
+ * @in xDataBufferSize   : size of the given pxDataBuffer.
+ * @in exFileMode        : Mode of file operation. It can be RDK_SS_FILE_MODE_WRITE or
+ *                         RDK_SS_FILE_MODE_APPEND
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_writeData ( unsigned int uintxSessionId,
+                                        char *pxDomain,
+                                        char *pxKey,
+                                        unsigned char *pxDataBuffer,
+                                        unsigned int xDataBufferSize,
+                                        RDK_SS_FILE_MODE_ENUM exFileMode );
+
+/***************************************************************************
+ * @brief API used to remove the session handle.
+ * @prerequisite       : rdk_ss_getFunction() call should be successful.
+ * @in/out pxSessionId : handle to indentify the session.
+ *                       it will be returned as 0 if the session closed successfully.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_closeSession ( unsigned int *pxSessionId );
+
+/***************************************************************************
+ * @brief API used to delete the directory/file from the root directory.
+ * @prerequisite          : rdk_ss_getFunction() call should be successful.
+ * @in uintxSessionId     : represent the session.
+ * @in pxDomain           : relative path from root directory.
+ *                          If pxDomain NULL and key valid, will search and delete the file from root directory
+ *                          If pxDomain and key both valid, will search and delete the file from specified directory
+ *                          If pxDomain valid and key NULL, will search and delete the file from specified directory
+ *                          If pxDomain and key both NULL, will return RDK_SS_ERROR_INVALID_INPUT error.
+ * @in pxKey              : name of the file.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_deleteData ( unsigned int uintxSessionId, char *pxDomain, char *pxKey );
+
+/***************************************************************************
+ * @brief API used to Terminate the Secure Storage functionalities and release the used resources
+ *        and memory. This function should be called once before the device shutdown.
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_terminate ( void );
+
+#endif /* __SECURE_STORAGE_H */
