+/************************** Global Functions *********************************/
+/***************************************************************************
+ * @brief API used to get the secure storage supported function pointer. This function must be called before calling
+ *        any other secure storage functions.
+ *
+ * @prerequisite             : None
+ *
+ * @out ppSSFunctionStruct   : double pointer which holds the address of RDK_SS_FUNCTION_STRUCT.
+ *                              using this pointer, user can call the other SS supported functions ( rdk_ss_init,
+ *                              rdk_ss_openSession, rdk_ss_readData, rdk_ss_writeData, rdk_ss_closeSession,
+ *                              rdk_ss_deleteData and rdk_ss_terminate)
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_INVALID_INPUT if invalid input
+ *         RDK_SS_ERROR_FAILURE if any error
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_getFunction ( RDK_SS_FUNCTION_STRUCT** ppxSSFunctionStruct )
+{
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+
+    for(;;)
+    {
+        if(NULL == ppxSSFunctionStruct)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("ppxSSFunctionStruct is NULL\n");
+            break;
+        }
+
+        if(0 != memcmp(gsstRdkSsFunction.acSSVersionString, RDK_SS_VERSION, RDK_SS_VERSION_SIZE))
+        {
+            gsstRdkSsFunction.rdk_ss_init           = rdk_ss_init;
+            memcpy(gsstRdkSsFunction.acSSVersionString, RDK_SS_VERSION, RDK_SS_VERSION_SIZE);
+            gsstRdkSsFunction.rdk_ss_openSession    = rdk_ss_openSession;
+            gsstRdkSsFunction.rdk_ss_readData       = rdk_ss_readData;
+            gsstRdkSsFunction.rdk_ss_writeData      = rdk_ss_writeData;
+            gsstRdkSsFunction.rdk_ss_closeSession   = rdk_ss_closeSession;
+            gsstRdkSsFunction.rdk_ss_deleteData     = rdk_ss_deleteData;
+            gsstRdkSsFunction.rdk_ss_terminate      = rdk_ss_terminate;
+        }
+
+        *ppxSSFunctionStruct = &gsstRdkSsFunction;
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    return eErrorCode;
+}
+
+/***************************************************************************
+ * @brief API used to Initialize the Secure Storage functionalities and allocate required resource and/or memory if need.
+ *        This function should be called once after the device bootup.
+ *
+ * @prerequisite : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstxSSInitInfo   : Address of SS Init Info structure which contains the below params,
+ *                        stDevicePath.data => Device Path name. Ex:- "/opt/secure"
+ *                        stDevicePath.size => size of the data
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_MEM_ALLOCATION if memory allocation failed
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_init ( RDK_SS_INIT_INFO_STRUCT *pstxSSInitInfo )
+{
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+
+    for(;;)
+    {
+        if(NULL == pstxSSInitInfo)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pstxSSInitInfo is NULL\n");
+        }
+
+        if(NULL == pstxSSInitInfo->stDevicePath.data ||
+           0 == pstxSSInitInfo->stDevicePath.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stDevicePath.data is NULL or stDevicePath.size is 0\n");
+            break;
+        }
+
+        if(gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_SUCCESS;
+            printf("Already Secure storage module initialized!!!\n");
+            break;
+        }
+
+        gsstSSDevicePath.data = (char*)malloc(pstxSSInitInfo->stDevicePath.size);
+        if(NULL == gsstSSDevicePath.data)
+        {
+            eErrorCode = RDK_SS_ERROR_MEM_ALLOCATION;
+            printf("Device Path memory alloc failed\n");
+            break;
+        }
+
+        gsstSSDevicePath.size = pstxSSInitInfo->stDevicePath.size;
+        memcpy(gsstSSDevicePath.data, pstxSSInitInfo->stDevicePath.data, gsstSSDevicePath.size);
+
+        if(!gsbRdkSSInitialization)
+        {
+            gsbRdkSSInitialization = TRUE;
+        }
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    return eErrorCode;
+}
+
+/***************************************************************************
+ * @brief API used to create the unique ciphering key and protect the stAppRootPath.
+ *        Returns the session handle as sessionId.
+ *
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstxSSOpenSessionIfo  : Address of SS Open Session Info structure which contains below params,
+ * @in  acMasterKey          : Array of 64 Byte Key.
+ *                              If acMasterKey is valid, will generate the ciphering key using acMasterKey
+ *                              If acMasterKey is NULL, internally will generate the unique ciphering key
+ * @in  stAppRootPath        : directory path in which the user want to keep the files as encrypted.
+ *                              stAppRootPath.data => Application directory path
+ *                                Ex:-
+ *                                  youtube                  -> Valid
+ *                                  youtube/secure_dir       -> Valid
+ *                                  youtube/secure_dir/test1 -> Valid
+ *                              stAppRootPath.size => size of the data
+ *
+ * @out uintSessionId        : returns the secure storage session id
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ *         RDK_SS_ERROR_MEM_ALLOCATION if memory allocation failed
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_openSession ( RDK_SS_OPENSESSION_INFO_STRUCT *pstxSSOpenSessionIfo )
+{
+    struct fscrypt_open_session_arg openSessionarg = {0};
+    char *rootPath         = NULL;
+    char *temp_path        = NULL;
+    int len    = 0;
+    int fd     = -1;
+    int ret    = -1;
+    RDK_SS_ERROR_ENUM eErrorCode = RDK_SS_ERROR_FAILURE;
+    unsigned char contents_encryption_mode;
+    unsigned char filenames_encryption_mode;
+    unsigned char padding_flags;
+    char acNullMasterKey[RDK_SS_MASTER_KEY_SIZE] = {0};
+    char *pAppRelativePath = NULL;
+    char *pAppAbsolutePath = NULL;
+    unsigned int appAbsolutePathLen = 0;
+    char isMasterKeyAvailable       = TRUE;
+    char  acProcessUserId[15]   = "user_id"; /* need to replace with actual uid data */
+    int   index  = 0;
+
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(NULL == pstxSSOpenSessionIfo)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pstxSSOpenSessionIfo is NULL\n");
+            break;
+        }
+
+        if(NULL == pstxSSOpenSessionIfo->stAppRootPath.data ||
+           0 == pstxSSOpenSessionIfo->stAppRootPath.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stAppRootPath.data is NULL OR stAppRootPath.size is 0\n");
+            break;
+        }
+
+        /* path should not contains '.' character */
+        if (NULL != strrchr(pstxSSOpenSessionIfo->stAppRootPath.data,'.'))
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stAppRootPath is invalid\n");
+            break;
+        }
+
+        if(0 == memcmp(pstxSSOpenSessionIfo->acMasterKey, acNullMasterKey, RDK_SS_MASTER_KEY_SIZE))
+        {
+            isMasterKeyAvailable = FALSE;
+            printf("MasterKey doesn't given by user\n");
+            /* should not break here as we internally will generate unique masterKey */
+        }
+
+        pstxSSOpenSessionIfo->uintSessionId = RDK_SS_INVALID_SESSION_ID;
+        pAppRelativePath = pstxSSOpenSessionIfo->stAppRootPath.data;
+
+        remove_last_slash_char(pAppRelativePath);
+
+        appAbsolutePathLen = gsstSSDevicePath.size
+                             + strlen(acProcessUserId) + 1
+                             + pstxSSOpenSessionIfo->stAppRootPath.size + 1 ;
+
+        pAppAbsolutePath = (char*)malloc(appAbsolutePathLen);
+        if(NULL == pAppAbsolutePath)
+        {
+            eErrorCode = RDK_SS_ERROR_MEM_ALLOCATION;
+            printf("App path memory allocation failed\n");
+            break;
+        }
+
+        /* make a app absolute path = device path + process uid + app relative path */
+        memcpy(pAppAbsolutePath, gsstSSDevicePath.data, gsstSSDevicePath.size);
+        index = gsstSSDevicePath.size;
+        pAppAbsolutePath[index++] = '/';
+
+        memcpy(pAppAbsolutePath + index,
+               acProcessUserId,
+               strlen(acProcessUserId));
+        index += strlen(acProcessUserId);
+
+        pAppAbsolutePath[index++] = '/';
+
+        memcpy(pAppAbsolutePath + index,
+               pAppRelativePath,
+               pstxSSOpenSessionIfo->stAppRootPath.size);
+        index += pstxSSOpenSessionIfo->stAppRootPath.size;
+        pAppAbsolutePath[index] = '\0';
+
+        ret = is_session_exist(pAppAbsolutePath, &pstxSSOpenSessionIfo->uintSessionId);
+        if (ret == 0)
+        {
+            eErrorCode = RDK_SS_ERROR_SUCCESS;
+            printf("Session[%u] already Exist!!!\n", pstxSSOpenSessionIfo->uintSessionId);
+            break;
+        }
+
+        ret = check_and_create_dir(pAppAbsolutePath);
+        if (ret < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("Path creation is falied for [%s] errorno[%u]\n", pAppAbsolutePath, errno);
+            break;
+        }
+
+        if (check_ownership_capability(pAppAbsolutePath)== RDK_SS_ERROR_FAILURE)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            break;
+        }
+
+        ret = get_fscrypt_encryption_mode(&contents_encryption_mode, &filenames_encryption_mode, &padding_flags);
+        if (ret < 0)
+        {
+            contents_encryption_mode  = FSCRYPT_MODE_AES_256_XTS;
+            filenames_encryption_mode = FSCRYPT_MODE_AES_256_CTS;
+            padding_flags = FSCRYPT_POLICY_FLAGS_PAD_32;
+        }
+
+        if(isMasterKeyAvailable)
+        {
+            memcpy(openSessionarg.master_key, pstxSSOpenSessionIfo->acMasterKey, RDK_SS_MASTER_KEY_SIZE);
+            openSessionarg.is_master_key_available = TRUE;
+        }
+
+        openSessionarg.policy.flags       = padding_flags;
+        openSessionarg.root_dir           = pAppAbsolutePath;
+        openSessionarg.policy.version     = FSCRYPT_POLICY_V2;
+        openSessionarg.policy.contents_encryption_mode     = contents_encryption_mode;
+        openSessionarg.policy.filenames_encryption_mode    = filenames_encryption_mode;
+
+        temp_path = strrchr(pAppAbsolutePath,'/');
+        if(NULL == temp_path)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("root path validation failed. [%s]\n", pAppAbsolutePath);
+            break;
+        }
+
+        len = appAbsolutePathLen-strlen(temp_path);
+        rootPath = (char *)malloc(len);
+        if (rootPath == NULL)
+        {
+            eErrorCode = RDK_SS_ERROR_MEM_ALLOCATION;
+            printf("Memory alloc failed size [%u]\n", appAbsolutePathLen);
+            break;
+        }
+
+        strncpy(rootPath, pAppAbsolutePath, len);
+        rootPath [len] = '\0';
+        fd = open(rootPath, O_RDONLY | O_CLOEXEC);
+        if (fd < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("App root path[%s] open Failure\n", rootPath);
+            break;
+        }
+
+        ret = ioctl(fd, FS_IOC_OPEN_SESSION, &openSessionarg);
+        if (ret != 0)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno, openSessionarg.session_id);
+            printf("[ioctl] Open session call failed. retun value %u\n", ret);
+            break;
+        }
+
+        pstxSSOpenSessionIfo->uintSessionId = openSessionarg.session_id;
+        ret = insert_session_info(fd, pAppAbsolutePath, pstxSSOpenSessionIfo->uintSessionId);
+
+        if(ret != 0 )
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("Insert_session info is Failed. session id %u\n", openSessionarg.session_id);
+        }
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    if(NULL != rootPath)
+    {
+        free(rootPath);
+        rootPath = NULL;
+    }
+    return eErrorCode;
+}
+
+/***************************************************************************
+ * @brief API used to write the data into the encrypted directory.
+ *
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstxSSWriteDataInfo   : Address of SS WriteData Session Info structure which contains below params,
+ * @in uintSessionId         : secure storage session id
+ *
+ * @in stDomain              : Relative path from app root directory.
+ *                              If stDomain.data == NULL, will write the data into stAppRootPath directory
+ *                              If stDomain.data != NULL, will write the data into the specified directory
+ *                                Ex: youtube             ==> secure storage path (stAppRootPath)
+ *                                    sample1             ==> domain path (stDomain)
+ *                                    youtube/sample1     ==> path to write the data if stDomain valid
+ *                                    youtube             ==> path to write the data if stDomain NULL
+ *                             stDomain.size -> size of the data
+ * @in stKey                 : file name to write the data. It must be valid.
+ *                             stKey.data -> file name.
+ *                             stKey.size -> size of the data
+ *
+ * @in/out stData            : buffer data to write into file. It must be valid.
+ *                           : stData.data -> buffer to write into file.
+ *                             stData.size -> size of the data
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_writeData ( RDK_SS_WRITE_DATA_INFO_STRUCT *pstxSSWriteDataInfo )
+{
+    struct fscrypt_write_data_arg arg     = {0};
+    RDK_SS_ERROR_ENUM eErrorCode    = RDK_SS_ERROR_FAILURE;
+    int fd     = -1;
+    int ret    = -1;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(NULL == pstxSSWriteDataInfo)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pstxSSWriteDataInfo is NULL\n");
+            break;
+        }
+
+        if(RDK_SS_SESSION_ID_RANGE_MIN > pstxSSWriteDataInfo->uintSessionId
+           || RDK_SS_SESSION_ID_RANGE_MAX < pstxSSWriteDataInfo->uintSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("Invalid uintSessionId [%u]\n", pstxSSWriteDataInfo->uintSessionId);
+            break;
+        }
+
+        if(NULL == pstxSSWriteDataInfo->stKey.data
+           || 0 == pstxSSWriteDataInfo->stKey.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stKey.data is NULL OR stKey.size is 0\n");
+            break;
+        }
+
+        if(NULL == pstxSSWriteDataInfo->stData.data
+           || 0 == pstxSSWriteDataInfo->stData.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stData.data is NULL OR stData.size is 0\n");
+            break;
+        }
+
+        if(RDK_SS_FILE_MODE_WRITE != pstxSSWriteDataInfo->eFileMode
+        && RDK_SS_FILE_MODE_APPEND != pstxSSWriteDataInfo->eFileMode)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("Invalid eFileMode [%u]\n", pstxSSWriteDataInfo->eFileMode);
+            break;
+        }
+
+        if(NULL == pstxSSWriteDataInfo->stDomain.data
+           && 0 != pstxSSWriteDataInfo->stDomain.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stDomain.data is NULL but stDomain.size is non-zero\n");
+            break;
+        }
+
+        if(NULL != pstxSSWriteDataInfo->stDomain.data
+           && 0 == pstxSSWriteDataInfo->stDomain.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stDomain.data is valid but stDomain.size is 0\n");
+            break;
+        }
+
+        if(NULL != pstxSSWriteDataInfo->stDomain.data)
+        {
+            remove_last_slash_char(pstxSSWriteDataInfo->stDomain.data);
+        }
+
+        arg.session_id      = pstxSSWriteDataInfo->uintSessionId;
+        arg.stDomain.data   = pstxSSWriteDataInfo->stDomain.data;
+        arg.stDomain.size   = pstxSSWriteDataInfo->stDomain.size;
+
+        arg.stKey.data      = pstxSSWriteDataInfo->stKey.data;
+        arg.stKey.size      = pstxSSWriteDataInfo->stKey.size;
+
+        arg.stData.data     = pstxSSWriteDataInfo->stData.data;
+        arg.stData.size     = pstxSSWriteDataInfo->stData.size;
+        arg.file_mode       = pstxSSWriteDataInfo->eFileMode;
+
+        fd = get_fileDesc(pstxSSWriteDataInfo->uintSessionId);
+        if(fd < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("fd is not found for the given sessionId %u\n", pstxSSWriteDataInfo->uintSessionId);
+            break;
+        }
+
+        ret = ioctl(fd, FS_IOC_WRITE_ENCRYPTION_FILE_DATA, &arg);
+        if (0 != ret)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno, pstxSSWriteDataInfo->uintSessionId);
+            printf("[ioctl] write data call failed. sessionId %u eErrorCode %u\n",
+                                   pstxSSWriteDataInfo->uintSessionId,
+                                   eErrorCode);
+            break;
+        }
+
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+    return eErrorCode;
+}
+
+/***************************************************************************
+ * @brief API used to read the file from the encrypted directory.
+ *
+ * @prerequisite             : rdk_ss_getFunction() call should be successful.
+ *
+ * @in pstxSSReadDataInfo    : Address of SS ReadData Session Info structure which contains below params,
+ * @in uintSessionId         : secure storage session id
+ *
+ * @in stDomain              : Relative path from the stAppRootPath directory.
+ *                              If stDomain.data == NULL, will read the file from stAppRootPath directory
+ *                              If stDomain.data != NULL, will read the file from the specified directory
+ *                                Ex: youtube             ==> secure storage path (stAppRootPath)
+ *                                    sample1             ==> domain path (stDomain)
+ *                                    youtube/sample1     ==> path to read the file if stDomain valid
+ *                                    youtube             ==> path to read the file if stDomain NULL
+ *                              stDomain.size -> size of the data
+ *
+ * @in stKey                 : File name to read. It must be valid.
+ *                             stKey.data -> file name.
+ *                             stKey.size -> size of the data
+ *
+ * @in/out stData            : Buffer to copy the data from file.
+ *                           : stData.data => buffer to copy data.
+ *                             stData.size => size of the data
+ *                               In below cases, fileSize will be return in stData.size.
+ *                                 1. If stData.size >= fileSize
+ *                                 2. If stData.size < fileSize
+ *                                 3. If stData.data == NULL & stData.size == 0
+ *
+ * @return RDK_SS_ERROR_SUCCESS if no error
+ *         RDK_SS_ERROR_NO_MODULE_INIT if rdk_ss_init not called before calling this function
+ *         RDK_SS_ERROR_FAILURE if any error
+ *         RDK_SS_ERROR_INVALID_INPUT if the input params are invalid
+ *         RDK_SS_ERROR_NOT_ENOUGH_MEMORY if the given buffer does not have enough memory to read file.
+ ***************************************************************************/
+RDK_SS_ERROR_ENUM rdk_ss_readData ( RDK_SS_READ_DATA_INFO_STRUCT *pstxSSReadDataInfo )
+{
+    struct fscrypt_read_data_arg arg     = {0};
+    RDK_SS_ERROR_ENUM eErrorCode    = RDK_SS_ERROR_FAILURE;
+    int fd     = -1;
+    int ret    = -1;
+
+    for(;;)
+    {
+        if(!gsbRdkSSInitialization)
+        {
+            eErrorCode = RDK_SS_ERROR_NO_MODULE_INIT;
+            printf("Please call Secure Stroage init function before calling this function");
+            break;
+        }
+
+        if(NULL == pstxSSReadDataInfo)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("pstxSSReadDataInfo is NULL\n");
+            break;
+        }
+
+        if(RDK_SS_SESSION_ID_RANGE_MIN > pstxSSReadDataInfo->uintSessionId
+           || RDK_SS_SESSION_ID_RANGE_MAX < pstxSSReadDataInfo->uintSessionId)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("Invalid uintSessionId [%u]\n", pstxSSReadDataInfo->uintSessionId);
+            break;
+        }
+
+        if(NULL == pstxSSReadDataInfo->stKey.data
+           || 0 == pstxSSReadDataInfo->stKey.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stKey.data is NULL OR stKey.size is 0\n");
+            break;
+        }
+
+        if(NULL != pstxSSReadDataInfo->stDomain.data
+           && 0 == pstxSSReadDataInfo->stDomain.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stDomain.data is valid but stDomain.size is 0\n");
+            break;
+        }
+
+        if(NULL == pstxSSReadDataInfo->stDomain.data
+           && 0 != pstxSSReadDataInfo->stDomain.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stDomain.data is NULL but stDomain.size is valid\n");
+            break;
+        }
+
+        if(NULL != pstxSSReadDataInfo->stData.data
+           && 0 == pstxSSReadDataInfo->stData.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stData.data is valid but stData.size is 0\n");
+            break;
+        }
+
+        if(NULL == pstxSSReadDataInfo->stData.data
+           && 0 != pstxSSReadDataInfo->stData.size)
+        {
+            eErrorCode = RDK_SS_ERROR_INVALID_INPUT;
+            printf("stData.data is NULL but stData.size is valid\n");
+            break;
+        }
+
+        if(NULL == pstxSSReadDataInfo->stData.data
+           && 0 == pstxSSReadDataInfo->stData.size)
+        {
+            printf("stData.data is NULL and stData.size is 0\n");
+            /* no need to break here as this is the valid case
+             * We should return the required file size in stData.size.
+             */
+        }
+
+        if(NULL != pstxSSReadDataInfo->stDomain.data)
+        {
+            remove_last_slash_char(pstxSSReadDataInfo->stDomain.data);
+        }
+
+        arg.session_id      = pstxSSReadDataInfo->uintSessionId;
+        arg.stDomain.data   = pstxSSReadDataInfo->stDomain.data;
+        arg.stDomain.size   = pstxSSReadDataInfo->stDomain.size;
+
+        arg.stKey.data      = pstxSSReadDataInfo->stKey.data;
+        arg.stKey.size      = pstxSSReadDataInfo->stKey.size;
+
+        arg.stData.data     = pstxSSReadDataInfo->stData.data;
+        arg.stData.size     = pstxSSReadDataInfo->stData.size;
+
+        fd = get_fileDesc(pstxSSReadDataInfo->uintSessionId);
+        if(fd < 0)
+        {
+            eErrorCode = RDK_SS_ERROR_FAILURE;
+            printf("fd is not found for the given sessionId %u\n", pstxSSReadDataInfo->uintSessionId);
+            break;
+        }
+
+        ret = ioctl(fd, FS_IOC_READ_ENCRYPTION_FILE_DATA, &arg);
+        if (ret != 0)
+        {
+            eErrorCode = convertErrnoToSSErrorCode(errno, pstxSSReadDataInfo->uintSessionId);
+            printf("[ioctl] read data call failed. sessionId %u eErrorCode %u\n", pstxSSReadDataInfo->uintSessionId, eErrorCode);
+            if (RDK_SS_ERROR_NOT_ENOUGH_MEMORY == eErrorCode && ret != arg.stData.size)
+            {
+                pstxSSReadDataInfo->stData.size = arg.stData.size;
+                printf("Expected stData.size is %u\n", arg.stData.size);
+                break;
+            }
+        }
+        eErrorCode = RDK_SS_ERROR_SUCCESS;
+        break;
+    }
+
+    return eErrorCode;
+}
