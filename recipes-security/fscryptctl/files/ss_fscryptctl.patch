+/***************************************************************************
+ * @brief API used to encrypt the application secure directory.
+ * @param keyid indicates key identifier.
+ * @param mountpoint indicates application secure directory mountpoint.
+ * @return EXIT_SUCCESS upon success else returns a EXIT_FAILURE.
+ ***************************************************************************/
+static int fscrypt_removeKey(char *keyid , char *mountpoint)
+{
+	char *const argv1[]={"remove_key",keyid,mountpoint};
+	return cmd_remove_key(3,argv1);
+}
+
+/***************************************************************************
+ * @brief API used to get the key identifier value.
+ * @param dirPath indicates application secure directory path.
+ * @return FSCRYPT_SUCCESS upon success else returns a FSCRYPT_FAILURE.
+ ***************************************************************************/
+static unsigned int fscrypt_getPolicy(char *dirPath)
+{
+	char *mountpoint = NULL;
+	char *temp_path = NULL;
+	int len =0;
+	char *const argv1[]={"get_policy",dirPath};
+	int ret = EXIT_FAILURE;
+
+	if(dirPath == NULL)
+  		return FSCRYPT_FAILURE;
+
+	ret = cmd_get_policy(2,argv1);
+
+	if (ret == EXIT_SUCCESS)
+	{
+		mountpoint = (char *)malloc(strlen(dirPath));
+		if (mountpoint == NULL)
+		{
+			printf("%s:%d Mem Alloc Fail\n",__FILE__,__LINE__);
+			return FSCRYPT_FAILURE;
+		}
+
+		temp_path = strrchr(dirPath,'/');
+		len = strlen(dirPath)-strlen(temp_path);
+		strncpy(mountpoint, dirPath,len);
+		mountpoint [len++] = '\0';
+		ret = fscrypt_removeKey(identifier_hex,mountpoint);
+		free(mountpoint);
+	}
+
+	if (ret == EXIT_FAILURE)
+	{
+		return FSCRYPT_FAILURE;
+	}
+
+	return FSCRYPT_SUCCESS;
+}
+
+/***************************************************************************
+ * @brief API used to get the return value based on the error number.
+ * @param errNo indicates error number from the kernel.
+ * @param sessionId indicates session info.
+ * @return appropriate error value.
+ ***************************************************************************/
+static unsigned int get_errno_return_value( int errNo, unsigned int sessionId)
+{
+	unsigned int status = FSCRYPT_FAILURE;
+	char *dirPath = NULL;
+	int ret = -1;
+
+	if (errNo == ENOENT || errNo == EIO || errNo == EFAULT || errNo == EINVAL || errNo == ENODATA )
+	{
+		status = FSCRYPT_INVALID_PARARM;
+	}
+	else if( errNo == ENOMEM)
+	{
+		status = FSCRYPT_FAILURE;
+	}
+	else if (errNo == EFBIG)
+	{
+		status = FSCRYPT_NO_MEM;
+	}
+	else if (errNo == EBUSY)
+	{
+		dirPath = get_application_path(sessionId);
+		if (dirPath != NULL)
+		{
+			status = fscrypt_getPolicy(dirPath);
+		}
+	}
+	else if (errNo == ENOKEY)
+	{
+		ret = free_session_info(sessionId);
+		if (ret < 0)
+		{
+			printf("%s:%d Free session info fail\n",__FILE__,__LINE__);
+			return FSCRYPT_FAILURE;
+		}
+		status = FSCRYPT_SUCCESS;
+	}
+	return status;
+}
+
+/***************************************************************************
+ * @brief API used to create a sub folder if not exist.
+ * @param dirPath indicates sub folder path.
+ * @return 0 upon success else returns appropriate error value.
+ ***************************************************************************/
+static int create_dir(char *dirPath)
+{
+	char *p = NULL;
+	char *dPath = strdup(dirPath);
+	int status = -1;
+
+	if(dirPath == NULL)
+		return status;
+
+	for (p = dPath + 1; *p; p++)
+	{
+		if (*p == '/')
+		{
+			*p = '\0';
+			if (access(dPath, F_OK) == -1)
+			{
+				status = mkdir(dPath, 0700);
+				if((status < 0) && (status != -EEXIST))
+				{
+					return status;
+				}
+			}
+			*p = '/';
+		}
+	}
+	status = mkdir(dPath, 0700);
+	return status;
+}
+
+/***************************************************************************
+ * @brief API used to create the specified directory in restrictive mode.
+ * @param dir indicates directory path.
+ * @return 0 upon success else returns appropriate error value.
+ ***************************************************************************/
+static int check_and_create_dir(char *dir)
+{
+	int status = -1;
+
+	if (dir == NULL)
+	{
+		printf("%s:%d the dir is NULL\n", __FILE__,__LINE__);
+		return status;
+	}
+	if (access(dir, F_OK) == 0)
+	{
+		return 0;
+	}
+	status = mkdir(dir, DIR_MODE);
+	if (status < 0)
+	{
+		status = create_dir(dir);
+	return status;
+	}
+	return status;
+}
+
+/***************************************************************************
+ * @brief API used to check the ownership capability.
+ * @param path indicates application secure directory path.
+ * @return FSCRYPT_SUCCESS upon success else returns FSCRYPT_FAILURE.
+ ***************************************************************************/
+static unsigned int check_ownership_capability(char *path)
+{
+	struct stat sb;
+	uid_t process_euid;
+	if(path == NULL)
+		return FSCRYPT_FAILURE;
+
+	if(stat(path, &sb) == -1)
+	{
+		return FSCRYPT_FAILURE;
+	}
+	process_euid = geteuid();
+	if(process_euid != sb.st_uid)
+	{
+		printf("%s:%d Encryption directory accces is restricted to user\n",__FILE__,__LINE__);
+		return FSCRYPT_FAILURE;
+	}
+	return FSCRYPT_SUCCESS;
+}
+
+/***************************************************************************
+ * @brief API used to get the content,filename encryption mode value and padding flag.
+ * @param contents_encryption_mode indicates contents encryption mode as a string.
+ * @param filenames_encryption_mode indicates filenames encryption mode as a string.
+ * @param padding_flags indicates padding flags as a string.
+ * @return 0 upon success else returns appropriate error value.
+ ***************************************************************************/
+static int get_fscrypt_encryption_mode(unsigned char *contents_encryption_mode,
+				unsigned char *filenames_encryption_mode, unsigned char *padding_flags )
+{
+	FILE *fp = NULL;
+	char line[256] = {0};
+
+	if(contents_encryption_mode == NULL || filenames_encryption_mode == NULL || padding_flags == NULL)
+		return -1;
+
+	fp = fopen("/etc/fscrypt.conf","r");
+
+	if (fp == NULL)
+	{
+		printf("%s:%d Unable to read fscrypt.conf file \n",__FILE__,__LINE__);
+		return -1;
+	}
+
+	while( fgets(line, sizeof(line), fp))
+	{
+		line[strcspn(line, "\n")] = '\0';
+		if(strncmp(FSCRYPT_PADDING,line,strlen(FSCRYPT_PADDING)) == 0)
+		{
+			char *s = strchr(line,':');
+			s++;
+			*padding_flags = string_to_padding_flag(s);
+		}
+		else if(strncmp(FSCRYPT_CONTENTS,line,strlen(FSCRYPT_CONTENTS)) == 0)
+		{
+			char *s = strchr(line,':');
+			s++;
+			string_to_mode(s, contents_encryption_mode);
+		}
+		else if (strncmp(FSCRYPT_FILENAMES,line,strlen(FSCRYPT_FILENAMES)) == 0)
+		{
+			char *s = strchr(line,':');
+			s++;
+			string_to_mode(s, filenames_encryption_mode);
+		}
+	}
+	fclose(fp);
+
+	return 0;
+}
+
+/***************************************************************************
+ * @brief API used to clear the session information.
+ * @param sessionId is used to represent the session.
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_closeSession (unsigned int *sessionId)
+{
+	int fd = -1;
+	int ret = -1;
+	struct fscrypt_close_session_arg closeSessionarg = {0};
+
+	if(sessionId == NULL)
+	{
+		printf("%s:%d Invalid Session Handle\n",__FILE__,__LINE__);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	fd = get_ioctl_fd(*sessionId);
+
+	if(fd < 0)
+	{
+		printf("%s:%d Invalid Param \n",__FILE__,__LINE__);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	closeSessionarg.session_id = *sessionId;
+
+	ret = ioctl(fd, FS_IOC_CLOSE_SESSION, &closeSessionarg);
+	if (ret != 0)
+	{
+		return get_errno_return_value(errno,*sessionId);
+	}
+
+	ret = free_session_info(*sessionId);
+
+	if (ret < 0)
+	{
+		printf("%s:%d Free session info fail\n",__FILE__,__LINE__);
+		return FSCRYPT_FAILURE;
+	}
+
+	*sessionId = INVALID_SESSION_ID;
+	return FSCRYPT_SUCCESS;
+}
+
+/***************************************************************************
+ * @brief API used to read the file from encrypted directory.
+ * @param sessionId is used to represent the session
+ * @param domain indicates sub folder of the encrypted directory
+ * @param key indicates file name
+ * @param dataBuffer indicates data buffer for read the data
+ * @param size indicates size of the file
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_readData (unsigned int sessionId, char *domain, char *key, unsigned char *dataBuffer, unsigned int *size)
+{
+	struct fscrypt_data_arg arg = {0};
+	int fd = -1;
+	char *dirPath = NULL;
+	unsigned int errorcode = FSCRYPT_FAILURE;
+	int ret = -1;
+
+	if ((sessionId < RANDOM_SESSION_ID_LOWER_MIN || sessionId > RANDOM_SESSION_ID_UPPER_MAX) || dataBuffer == NULL || size == NULL || *size == 0 || key == NULL)
+	{
+		printf("%s:%d Invalid param\n",__FILE__,__LINE__);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	remove_last_slash_char(domain);
+
+	arg.session_id = sessionId;
+	arg.domain = domain;
+	arg.key = key;
+	arg.data = dataBuffer;
+	arg.data_len = *size;
+
+	fd = get_ioctl_fd(sessionId);
+
+	if(fd < 0)
+	{
+		printf("%s:%d Invalid Param \n",__FILE__,__LINE__);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	ret = ioctl(fd, FS_IOC_READ_ENCRYPTION_FILE_DATA, &arg);
+	if (ret != 0 && ret != arg.data_len)
+	{
+		errorcode = get_errno_return_value(errno,sessionId);
+		if (errorcode == FSCRYPT_NO_MEM)
+		{
+			*size = arg.data_len;
+		}
+		return errorcode;
+	}
+	return FSCRYPT_SUCCESS;
+}
+
+/***************************************************************************
+ * @brief API used to write the file from encrypted directory.
+ * @param sessionId is used to represent the session
+ * @param domain indicates sub folder of the encrypted directory
+ * @param key indicates file name
+ * @param dataBuffer indicates data buffer to write the data
+ * @param size indicates size of the file
+ * @param fmode indicates file mode
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_writeData (unsigned int sessionId, char *domain, char *key, unsigned char *dataBuffer, unsigned int size, int fmode)
+{
+	struct fscrypt_data_arg arg = {0};
+	int fd = -1;
+	char *dirPath = NULL;
+	int ret = -1;
+
+	if ((sessionId < RANDOM_SESSION_ID_LOWER_MIN || sessionId > RANDOM_SESSION_ID_UPPER_MAX) || dataBuffer == NULL || size == 0 || key == NULL)
+	{
+		printf("%s:%d Invalid param\n",__FILE__,__LINE__);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	remove_last_slash_char(domain);
+
+	arg.session_id = sessionId;
+	arg.domain = domain;
+	arg.key = key;
+	arg.data = dataBuffer;
+	arg.data_len = size;
+	arg.file_mode = fmode;
+
+	fd = get_ioctl_fd(sessionId);
+
+	if(fd < 0)
+	{
+		printf("%s:%d Invalid Param \n",__FILE__,__LINE__);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	ret = ioctl(fd, FS_IOC_WRITE_ENCRYPTION_FILE_DATA, &arg);
+	if (ret !=0 )
+	{
+		return get_errno_return_value(errno,sessionId);
+	}
+	return FSCRYPT_SUCCESS;
+}
+
+/***************************************************************************
+ * @brief API used to add the key in keyring and set the encryption policy.
+ * @param masterKey indicates master key path or NULL if NULL, master key generated by kernel space and should be unique.
+ * @param application_root_path indicates a user encrypted directory path and stored the information under this path.
+ * @param sessionId is used to represent the session
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_openSession (char *masterKey, char *application_root_path, unsigned int *sessionId)
+{
+	unsigned char contents_encryption_mode;
+	unsigned char filenames_encryption_mode;
+	unsigned char padding_flags;
+	struct fscrypt_open_session_arg openSessionarg = {0};
+	int ret = -1;
+	char *mountpoint = NULL;
+	char *temp_path = NULL;
+	int len = 0;
+	unsigned int sessionID = 0;
+	int fd = -1;
+
+	if(application_root_path == NULL || sessionId == NULL)
+		return FSCRYPT_FAILURE;
+
+	remove_last_slash_char(application_root_path);
+
+	ret = is_session_exist(application_root_path,&sessionID);
+
+	if (ret == 0)
+	{
+		printf("Session[%u] already Exist!!!\n",sessionID);
+		*sessionId = sessionID;
+		return FSCRYPT_SUCCESS;
+	}
+
+	ret = check_and_create_dir(application_root_path);
+
+	if (ret < 0)
+	{
+		printf("%s:%d Invalid Application root path,errno[%d]\n",__FILE__,__LINE__,errno);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	if (check_ownership_capability(application_root_path)== FSCRYPT_FAILURE)
+	{
+		return FSCRYPT_FAILURE;
+	}
+
+	ret = get_fscrypt_encryption_mode(&contents_encryption_mode, &filenames_encryption_mode, &padding_flags);
+
+	if (ret < 0)
+	{
+		contents_encryption_mode = FSCRYPT_MODE_AES_256_XTS;
+		filenames_encryption_mode = FSCRYPT_MODE_AES_256_CTS;
+		padding_flags = FSCRYPT_POLICY_FLAGS_PAD_32;
+	}
+
+	openSessionarg.master_key = masterKey;
+	openSessionarg.root_dir = application_root_path;
+	openSessionarg.policy.version = FSCRYPT_POLICY_V2;
+	openSessionarg.policy.contents_encryption_mode = contents_encryption_mode;
+	openSessionarg.policy.filenames_encryption_mode = filenames_encryption_mode;
+	openSessionarg.policy.flags = padding_flags;
+
+	/*Secure directory mount path is called mountpoint
+
+	Ex: /opt/secure/netflix        ==> secure directory mount path (mountpoint)
+	/opt/secure/netflix/secure_dir ==> secure storagepath (application_root_path)*/
+
+	mountpoint = (char *)malloc(strlen(application_root_path));
+
+	if (mountpoint == NULL)
+	{
+		printf("%s:%d Mem Alloc Fail\n",__FILE__,__LINE__);
+		return FSCRYPT_FAILURE;
+	}
+
+	temp_path = strrchr(application_root_path,'/');
+
+	if (temp_path == NULL)
+	{
+		printf("%s:%d Invalid path\n",__FILE__,__LINE__);
+		free(mountpoint);
+		return FSCRYPT_FAILURE;
+	}
+
+	len = strlen(application_root_path)-strlen(temp_path);
+	strncpy(mountpoint, application_root_path,len);
+	mountpoint [len++] = '\0';
+
+	fd = open(mountpoint, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+	{
+		printf("%s:%d Mountpoint[%s] open Fail\n",__FILE__,__LINE__,mountpoint);
+		free(mountpoint);
+		return FSCRYPT_FAILURE;
+	}
+
+	ret = ioctl(fd, FS_IOC_OPEN_SESSION, &openSessionarg);
+
+	if (ret != 0)
+	{
+		printf("%s:%d Open Session CMD fail\n",__FILE__,__LINE__);
+		free(mountpoint);
+		return get_errno_return_value(errno,openSessionarg.session_id);
+	}
+
+	*sessionId = openSessionarg.session_id;
+
+	ret = insert_session_info(fd, application_root_path, *sessionId);
+	if(ret != 0 )
+	{
+		printf("%s:%d insert_session_info API Failed\n",__FILE__,__LINE__);
+		free(mountpoint);
+        return FSCRYPT_FAILURE;
+	}
+
+
+	free(mountpoint);
+
+	return FSCRYPT_SUCCESS;
+}
+
+/***************************************************************************
+ * @brief API used to delete the folder and file from encrypted directory.
+ * @param sessionId is used to represent the session.
+ * @param domain indicates sub folder of the encrypted directory
+ * @param key indicates file name
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_deleteData (unsigned int sessionId, char *domain, char *key)
+{
+	struct fscrypt_delete_file_arg arg = {0};
+	int fd = -1;
+	int ret = -1;
+
+	if(key == NULL)
+		return FSCRYPT_INVALID_PARARM;
+
+	if (sessionId < RANDOM_SESSION_ID_LOWER_MIN || sessionId > RANDOM_SESSION_ID_UPPER_MAX)
+	{
+		printf("%s:%d Invalid param\n",__FILE__,__LINE__);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	remove_last_slash_char(domain);
+
+	arg.session_id = sessionId;
+	arg.domain = domain;
+	arg.key = key;
+
+	fd = get_ioctl_fd(sessionId);
+	if(fd < 0)
+	{
+		printf("%s:%d Invalid Param \n",__FILE__,__LINE__);
+		return FSCRYPT_INVALID_PARARM;
+	}
+
+	ret = ioctl(fd, FS_IOC_DELETE_DATA, &arg);
+	if (ret != 0)
+	{
+		return get_errno_return_value(errno,sessionId);
+	}
+	return FSCRYPT_SUCCESS;
+}
