+#ifndef _SS_FSCRYPTCTL_H
+#define _SS_FSCRYPTCTL_H
+
+/* Include Files */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <fcntl.h>
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* Session id range */
+#define RANDOM_SESSION_ID_LOWER_MIN     1000
+#define RANDOM_SESSION_ID_UPPER_MAX     100000
+#define INVALID_SESSION_ID 0
+
+/* Error Codes */
+#define FSCRYPT_SUCCESS 0x00000000
+#define FSCRYPT_FAILURE 0x00000001
+#define FSCRYPT_INVALID_PARARM 0x00000010
+#define FSCRYPT_NO_MEM 0x00000011
+
+/* Set Policy inputs */
+#define FSCRYPT_PADDING  	"padding:"
+#define FSCRYPT_CONTENTS 	"contents:"
+#define FSCRYPT_FILENAMES	"filenames:"
+#define FSCRYPT_KEY_IDENTIFIER_SIZE	16
+#define FSCRYPT_POLICY_V2		2
+
+/* Encryption Modes */
+#define FSCRYPT_MODE_AES_256_XTS                1
+#define FSCRYPT_MODE_AES_256_CTS                4
+#define FSCRYPT_MODE_AES_128_CBC                5
+#define FSCRYPT_MODE_AES_128_CTS                6
+#define FSCRYPT_MODE_SM4_XTS                    7
+#define FSCRYPT_MODE_SM4_CTS                    8
+#define FSCRYPT_MODE_ADIANTUM                   9
+#define FSCRYPT_MODE_AES_256_HCTR2              10
+
+/* Encryption policy flags */
+#define FSCRYPT_POLICY_FLAGS_PAD_4			0x00
+#define FSCRYPT_POLICY_FLAGS_PAD_8			0x01
+#define FSCRYPT_POLICY_FLAGS_PAD_16			0x02
+#define FSCRYPT_POLICY_FLAGS_PAD_32			0x03
+#define FSCRYPT_POLICY_FLAGS_PAD_MASK		0x03
+#define FSCRYPT_POLICY_FLAG_DIRECT_KEY		0x04
+#define FSCRYPT_POLICY_FLAG_IV_INO_LBLK_64	0x08
+#define FSCRYPT_POLICY_FLAG_IV_INO_LBLK_32	0x10
+
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+#define DIR_MODE    0700
+
+/* Write IOCTL call file mode*/
+typedef enum {
+	FSCRYPT_WRITE = 0,
+	FSCRYPT_APPEND,
+}fscrypt_file_mode;
+
+/* Session information structure */
+struct session_t {
+	int fd;
+	char *rootDir;
+	unsigned int session_id;
+	struct session_t *next;
+};
+
+/* Policy structure */
+struct fscrypt_policy_v2 {
+	unsigned char version;
+	unsigned char contents_encryption_mode;
+	unsigned char filenames_encryption_mode;
+	unsigned char flags;
+	unsigned char __reserved[4];
+	unsigned char master_key_identifier[FSCRYPT_KEY_IDENTIFIER_SIZE];
+};
+
+/* Struct passed to FS_IOC_OPEN_SESSION */
+struct fscrypt_open_session_arg {
+	char *master_key;
+	char *root_dir;
+	struct fscrypt_policy_v2 policy;
+	unsigned int session_id;
+};
+/* Struct passed to FS_IOC_CLOSE_SESSION */
+struct fscrypt_close_session_arg {
+	unsigned int session_id;
+};
+
+/* Struct passed to FS_IOC_READ_ENCRYPTION_FILE_DATA/FS_IOC_WRITE_ENCRYPTION_FILE_DATA */
+struct fscrypt_data_arg {
+	unsigned char *domain;
+	unsigned char *key;
+	unsigned char *data;
+	int data_len;
+	fscrypt_file_mode file_mode;
+	unsigned int session_id;
+};
+
+/* Struct passed to FS_IOC_DELETE_DATA */
+struct fscrypt_delete_file_arg {
+	unsigned char *domain;
+	unsigned char *key;
+	unsigned int session_id;
+};
+
+/* IOCTL commands */
+#define FS_IOC_OPEN_SESSION						_IOWR('f', 28, struct fscrypt_open_session_arg)
+#define FS_IOC_READ_ENCRYPTION_FILE_DATA		_IOWR('f', 29, struct fscrypt_data_arg)
+#define FS_IOC_WRITE_ENCRYPTION_FILE_DATA		_IOWR('f', 30, struct fscrypt_data_arg)
+#define FS_IOC_CLOSE_SESSION					_IOWR('f', 31, struct fscrypt_close_session_arg)
+#define FS_IOC_DELETE_DATA						_IOR('f', 32, struct fscrypt_delete_file_arg)
+
+/* Global Function protypes */
+/***************************************************************************
+ * @brief API used to add the key in keyring and set the encryption policy.
+ * @param masterKey indicates master key path or NULL if NULL, master key generated by kernel space and should be unique.
+ * @param application_root_path indicates a user encrypted directory path and stored the information under this path.
+ * @param sessionId is used to represent the session
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_openSession (char *masterKey, char *application_root_path, unsigned int *sessionId);
+
+/***************************************************************************
+ * @brief API used to read the file from encrypted directory.
+ * @param sessionId is used to represent the session
+ * @param domain indicates sub folder of the encrypted directory
+ * @param key indicates file name
+ * @param dataBuffer indicates data buffer for read the data
+ * @param size indicates size of the file
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_readData (unsigned int sessionId, char *domain, char *key, unsigned char *dataBuffer, unsigned int *size);
+
+/***************************************************************************
+ * @brief API used to write the file from encrypted directory.
+ * @param sessionId is used to represent the session
+ * @param domain indicates sub folder of the encrypted directory
+ * @param key indicates file name
+ * @param dataBuffer indicates data buffer to write the data
+ * @param size indicates size of the file
+ * @param fmode indicates file mode
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_writeData (unsigned int sessionId, char *domain, char *key, unsigned char *dataBuffer, unsigned int size, int fmode);
+
+/***************************************************************************
+ * @brief API used to clear the session information.
+ * @param sessionId is used to represent the session.
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_closeSession (unsigned int *sessionId);
+
+/***************************************************************************
+ * @brief API used to delete the folder and file from encrypted directory.
+ * @param sessionId is used to represent the session.
+ * @param domain indicates sub folder of the encrypted directory
+ * @param key indicates file name
+ * @return FSCRYPT_SUCCESS upon success else returned FSCRYPT_FAILURE or error code.
+ ***************************************************************************/
+unsigned int fscrypt_deleteData (unsigned int sessionId, char *domain, char *key);
+
+#endif /* _SS_FSCRYPTCTL_H */
