+void ssh_logging(const char* format, ...) {
+#ifdef RDK_BROADBAND
+    if ((access("/rdklogs/logs/rdk_shell.log", F_OK ) != 0)) {
+        symlink("/opt/secure/rdk_shell.log","/rdklogs/logs/rdk_shell.log");
+    }
+#else
+    if ((access("/opt/logs/rdk_shell.log", F_OK ) != 0)) {
+        symlink("/opt/secure/rdk_shell.log","/opt/logs/rdk_shell.log");
+    }
+#endif
+    FILE* fp = NULL;
+    fp = fopen(SSH_SHELL_LOG, "a+");
+    if (fp != NULL) {
+        char printbuf[1024];
+        va_list param;
+        // Get current timestamp
+        char timestamp[64];
+        time_t now = time(NULL);
+        struct tm* t = localtime(&now);
+        strftime(timestamp, sizeof(timestamp), "%Y-%m-%d %H:%M:%S", t);
+        // Get unique session ID (using PID)
+        pid_t session_id = getpid();
+        // Get the username
+        struct passwd *pw = getpwuid(geteuid());
+        char *username = pw ? pw->pw_name : "unknown_user";
+        va_start(param, format);
+        vsnprintf(printbuf, sizeof(printbuf), format, param);
+        // Write the formatted log with timestamp, session ID, and username
+        fprintf(fp, "[%s] [Session ID: %d] [User: %s] %s", timestamp, session_id, username, printbuf);
+        va_end(param);
+        fclose(fp);
+    }
+    else {
+        fprintf(stderr, "Error opening file \n");
+    }
+}
 
