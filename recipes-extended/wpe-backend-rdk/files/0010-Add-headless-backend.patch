+
+add_definitions(-DBACKEND_HEADLESS=1)
+
+list(APPEND WPE_PLATFORM_INCLUDE_DIRECTORIES
+    "${CMAKE_SOURCE_DIR}/src/headless"
+)
+
+list(APPEND WPE_PLATFORM_SOURCES
+    src/headless/view-backend.cpp
+)
