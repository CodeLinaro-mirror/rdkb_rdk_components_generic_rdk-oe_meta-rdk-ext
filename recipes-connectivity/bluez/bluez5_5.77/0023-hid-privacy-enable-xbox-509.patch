+static void device_set_auto_connect(struct btd_device *device, gboolean enable)
+{
+        char addr[MAX_ADDR_SIZE];
+
+        if (!device || !device->le)
+                return;
+
+        ba2str(&device->bdaddr, addr);
+
+        DBG("%s auto connect: %d", addr, enable);
+
+        if (device->auto_connect == enable)
+                return;
+
+        device->auto_connect = enable;
+
+        /* Disabling auto connect */
+        if (enable == FALSE) {
+                adapter_connect_list_remove(device->adapter, device);
+                adapter_auto_connect_remove(device->adapter, device);
+                return;
+        }
+
+        /* Enabling auto connect */
+        adapter_auto_connect_add(device->adapter, device);
+
+        if (device->attrib) {
+                DBG("Already connected");
+                return;
+        }
+
+        adapter_connect_list_add(device->adapter, device);
+}
+
+int store_hid_info(char *modalias,char *addr)
+{
+        struct hid_firm_info *data = NULL,*temp = NULL;
+
+        DBG("");
+        data = g_new0(struct hid_firm_info, sizeof(struct hid_firm_info));
+        strncpy (data->hid_mac_address, addr, MAX_ADDR_SIZE);
+        strncpy (data->hid_firm_version, modalias, MAX_FIRM_VER_SIZE);
+
+        if (head == NULL) {
+                data->next = head;
+                head = data;
+        } else {
+                temp = head;
+                while (temp->next != NULL)
+                        temp = temp->next;
+                data->next = temp->next;
+                temp->next = data;
+        }
+        temp = NULL;
+        return 0;
+}
+
+bool get_hid_info(char *modalias,char *addr)
+{
+        struct hid_firm_info *current = head;
+        while (current != NULL) {
+                if ((strncmp(current->hid_firm_version, modalias, MAX_FIRM_VER_SIZE - 1) == 0) && (strncmp(current->hid_mac_address, addr, MAX_ADDR_SIZE - 1) == 0)) {
+                        return TRUE;
+                }
+                current = current->next;
+        }
+        return FALSE;
+}
