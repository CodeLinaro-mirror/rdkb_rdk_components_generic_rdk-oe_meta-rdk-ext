+void change_adapter_privacy_mode(struct btd_adapter *adapter,uint8_t privacy)
+{
+        DBG("Setting privacy mode : %u",privacy);
+        set_adapter_privacy(adapter,privacy);
+        btd_opts.privacy = privacy;
+}
+
+bool get_privacy_status (struct btd_adapter *adapter)
+{
+        if (btd_opts.privacy == 0x00) {
+                DBG("Privacy Disabled");
+                return false;
+        } else if (btd_opts.privacy == 0x01) {
+                DBG("Privacy enabled");
+                return true;
+        }
+}
