+static void set_adapter_privacy(struct btd_adapter *adapter, uint8_t privacy)
+{
+        struct mgmt_cp_set_privacy cp;
+        int fd;
+
+        fd = open("/dev/urandom", O_RDONLY);
+        if (fd < 0) {
+                DBG("Not able to open the file");
+                return -1;
+        }
+
+        if (read(fd, cp.irk, sizeof(cp.irk)) != sizeof(cp.irk)) {
+                DBG("Failed to read the irk key");
+                close(fd);
+                return -1;
+        }
+
+        cp.privacy = privacy;
+        close(fd);
+
+        if (mgmt_send(adapter->mgmt, MGMT_OP_SET_PRIVACY,adapter->dev_id, sizeof(cp), &cp, set_privacy_complete, adapter, NULL) > 0)
+                return 0;
+}
